<apex:page renderAs="pdf" applyHtmlTag="false" applyBodyTag="false" showHeader="false" standardStylesheets="false" cache="false" language="en-US">
<html>
<head>
<style type="text/css">
  @page { size: letter; margin: 0.45in 0.5in 0.5in 0.5in; }
  body { font-family: Arial, Helvetica, sans-serif; font-size: 8pt; color:#111111; margin:0; padding:0; }
  .lab { font-size: 7pt; color:#b3121f; font-weight:bold; margin: 0 0 2px 0; }
  .blk { margin: 0 0 6px 0; }
</style>
</head>
<body>
<div class="blk"><div class="lab">S1 width:2.5in</div><img style="width:2.5in" src="{!$Resource.ZZ_SigProbe_SignatureWhite}" /></div>
<div class="blk"><div class="lab">S2 width:180pt</div><img style="width:180pt" src="{!$Resource.ZZ_SigProbe_SignatureWhite}" /></div>
<div class="blk"><div class="lab">S3 width:200px</div><img style="width:200px" src="{!$Resource.ZZ_SigProbe_SignatureWhite}" /></div>
<div class="blk"><div class="lab">S4 no width attribute</div><img src="{!$Resource.ZZ_SigProbe_SignatureWhite}" /></div>
<div class="blk"><div class="lab">S5 width:1.25in</div><img style="width:1.25in" src="{!$Resource.ZZ_SigProbe_SignatureWhite}" /></div>
</body>
</html>
</apex:page>