<apex:page controller="ApplicationSummaryController"
           renderAs="pdf"
           applyHtmlTag="false"
           showHeader="false"
           standardStylesheets="false"
           cache="true">

  <html>
  <head>
    <meta charset="UTF-8"/>
    <style>
      <!-- ---- colors & helpers ---->
      :root { --blue:#0C2D5A; }
      .force-print-color{ -webkit-print-color-adjust: exact; print-color-adjust: exact; }

      /* ---- page / type ---- */
      @page { size:A4; margin:14mm 14mm 16mm 14mm; }
      body  { font-family: Arial, Helvetica, sans-serif; font-size:11px; color:#111; }

      h1.title { font-size:20px; margin:6px 0 6px; text-align:center; letter-spacing:.3px; }
      .hr { height:0; border-top:1px solid #979797; margin:8px 0 12px; }

      /* ---- header ---- */
      table.header { width:100%; border-collapse:collapse; }
      table.header td { vertical-align:top; }
      .addr { font-size:10px; line-height:1.35; text-align:right; }
      .pno  { color:#D12A8F; font-size:20px; font-weight:bold; }

      /* ---- section bars ---- */
      .section { margin:12px 0 10px; }
      .sec-hd  { background:var(--blue); color:#fff; border:1px solid var(--blue);
                 padding:7px 10px; font-weight:bold; text-transform:uppercase; }
      .sec-wrap{ border:1px solid #111; border-top:none; }

      /* ---- data tables ---- */
      table.grid { width:100%; border-collapse:collapse; }
      table.grid th, table.grid td { border:1px solid #111; padding:6px 8px; vertical-align:top; }
      table.grid th { background:#fff; font-weight:bold; }  /* keep cells white per original */

      .two-col { display:flex; gap:14px; }
      .col { flex:1; }
      .label { font-weight:bold; }
      .right { text-align:right; }
      .small { font-size:10px; }
      .muted { color:#444; }

      /* ---- keep your original summary panel styling ---- */
      h2 { font-size:13px; margin:14px 0 6px; text-transform:uppercase; }
      .summary { border:1px solid #111; padding:10px 12px; margin:8px 0 10px; }
    </style>
  </head>
  <body class="force-print-color">

    <!-- ===== HEADER (as original) ===== -->
    <!-- ===== HEADER ===== -->
<table class="header">
  <tr>
    <!-- Left: Car Loan Protection Program logo -->
    <td class="header-left">
      <!-- Placeholder box. Replace with <apex:image .../> when ready -->
      <div class="logo-ph">CLP LOGO</div>
      <!-- Example (uncomment & set resource):
      <apex:image url="{!$Resource.CLP_Logo}" width="180" height="56" />
      -->
    </td>

    <!-- Right: P15111 (top-right), then A-Protect logo + address + phones -->
    <td class="header-right">
      <table class="right-block">
        <tr>
          <td></td>
          <td class="right-top"><div class="pno">P15111</div></td>
        </tr>
        <tr>
          <td colspan="2">
            <table class="contact">
              <tr>
                <!-- A-Protect logo -->
                <td style="width:120px; vertical-align:top;">
                  <!-- Placeholder box. Replace with <apex:image .../> when ready -->
                  <div class="logo-ph small">A-PROTECT LOGO</div>
                  <!-- Example (uncomment & set resource):
                  <apex:image url="{!$Resource.AProtect_Logo}" width="110" height="50" />
                  -->
                </td>

                <!-- Address (center/right area, left-aligned) -->
                <td class="addr" style="width:60%; vertical-align:top;">
                  7250 Keele St. Suite 421<br/>
                  Concord, ON<br/>
                  L4K 1Z8
                </td>

                <!-- Phones (far right, right-aligned) -->
                <td class="phones" style="width:40%; vertical-align:top;">
                  Tel: (416) 661-7444<br/>
                  Fax: (416) 661-7448<br/>
                  Toll Free: 1-866-660-6444
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>


    <div class="hr"></div>
    <h1 class="title">CAR LOAN PROTECTION APPLICATION</h1>
    <div class="hr"></div>

    <!-- ===== CUSTOMER / LESSEE (dark-blue bar) ===== -->
    <div class="section">
      <div class="sec-hd force-print-color " style="background-color:#0C2D5A;">Customer / Lessee Information</div>
      <div class="sec-wrap">
        <table class="grid">
          <tr>
            <th colspan="2">Last Name</th><th colspan="2">First Name</th>
          </tr>
            <tr>
            <td colspan="2">{!VM.firstName}</td><td colspan="2">{!VM.lastName}</td>
            </tr>
          <tr>
            <th colspan="3">Address</th><th>City</th>
          </tr>
          <tr>
			<td colspan="3">{!VM.address}</td><td>{!VM.city}</td>
          </tr>
          <tr>
            <th>Province</th><th>Postal Code</th><th>Home phone</th><th>Business phone</th>
          </tr>
            <tr>
            <td>{!VM.province}</td><td>{!VM.postalCode}</td><td>{!VM.homePhone}</td><td>{!VM.businessPhone}</td></tr>
          <tr>
            <th colspan = "1">Email: </th><td>{!VM.email}</td>
          </tr>
        </table>
      </div>
    </div>

    <!-- ===== VEHICLE (dark-blue bar) ===== -->
    <div class="section">
      <div class="sec-hd force-print-color" style="background-color:#0C2D5A;">Vehicle Information</div>
      <div class="sec-wrap">
        <table class="grid">
          <tr>
            <th>Year</th><th>Make</th><th>Model</th><th>Odometer</th><th>Purchase Price</th>
            
          </tr>
          <tr>
            <td>{!VM.Year}</td><td>{!VM.Model}</td><td>{!VM.Make}</td><td>{!VM.odometer}</td><td>
              <apex:outputText value="{0, number, currency}">
                <apex:param value="{!VM.purchasePrice}"/>
              </apex:outputText>
            </td>
          </tr>
          <tr>
            <th colspan = "1">V.I.N:</th><td>{!VM.vin}</td>
          </tr>
        </table>
      </div>
    </div>

    <!-- ===== DEALER (dark-blue bar) ===== -->
    <div class="section">
      <div class="sec-hd force-print-color" style="background-color:#0C2D5A;">Dealer / Retailer Information</div>
      <div class="sec-wrap">
        <table class="grid">
          <tr>
            <th>Dealer name</th><th>Dealer code</th><th>Dealer phone</th>
          </tr>
            <tr>
            <td>{!VM.dealerName}</td><td>{!VM.dealerCode}</td><td>{!VM.dealerPhone}</td>
            </tr>
          <tr>
            <th colspan = "1">Dealer address: </th><td>{!VM.dealerAddress}</td>
          </tr>
        </table>
      </div>
    </div>

    <!-- ======= SUMMARY (unchanged from your original) ======= -->
    <!-- Summary (dark-blue heading) -->
<div class="sec-hd force-print-color" style="background-color:#0C2D5A;color:#fff;">Summary</div>
<div class="summary" style="text-align:center;">
  <div><span class="label">GAP PLUS</span></div>
  <div>Coverage Term: {!VM.coverageTerm}</div>
  <div>Amount Financed: {!VM.amountFinancedRange}</div>

  <!-- Financial Institution moved inside Summary -->
  <div style="margin-top:8px;">
    <div class="label">Financial Institution</div>
    <div class="small muted">{!IF(ISBLANK(VM.financialInstitution),'',VM.financialInstitution)}</div>
  </div>
    
    <div class="two-col">
  <div class="col">
    <h2>Office Use</h2>
    <table class="grid">
      <tr>
        <th colspan = "2">Charge</th>
        <td class="right">
          <apex:outputText value="{0, number, currency}">
            <apex:param value="{!VM.charge}"/>
          </apex:outputText>
        </td>
      </tr>
      <tr>
        <th colspan = "2">HST/GST</th>
        <td class="right">
          <apex:outputText value="{0, number, currency}">
            <apex:param value="{!VM.tax}"/>
          </apex:outputText>
        </td>
      </tr>
      <tr>
        <th colspan = "2">Total</th>
        <td class="right">
          <apex:outputText value="{0, number, currency}">
            <apex:param value="{!VM.total}"/>
          </apex:outputText>
        </td>
      </tr>
    </table>
  </div>
</div>
</div>

<!-- Office Use (kept outside Summary, same as before) -->


    <div class="tight small" style="margin-top:8px;">
      <p><strong>IMPORTANT:</strong> PLEASE DO NOT ACCEPT INSURANCE OFFERS/SETTLEMENTS WITHOUT CONTACTING A-PROTECT
      AS IT MAY AFFECT THE OVERALL GAP SETTLEMENT.</p>
    </div>

    <h2>Terms and Conditions</h2>
    <div class="small tight">
      <ol>
        <li>This Car Loan Protection Application is solely intended as an offer, with all considerations that the information provided above is valid and true.</li>
        <li>Car Loan Protection coverage commences at the time the Finance Contract is executed. For GAP Coverage/Collision Deductible Programs: The selected coverage term and amount must be equivalent to the Financed Loan Term/Amount.</li>
        <li>CLAIMS - The Customer must contact A-Protect GAP Coverage during business hours (Monday-Friday) from 9 AM - 5 PM EST at 1.866.660.6444 or 416.661.7444.</li>
        <li>The Customer must inform and notify A-Protect prior to the acceptance/issuance of any compensation issued by the primary insurer. A list of required documents... (see next page).</li>
        <li>Police/fire reports must be filed the date of the accident, fire or theft. Standalone occurrence numbers or Self Reporting Collision Reports will not be accepted.</li>
        <li>Commercial/Business use vehicles are not permitted under the Car Loan Protection Program. *Exclusively for Driver GAP Coverage program, light commercial/business use such as rideshare/delivery purposes are permitted.</li>
        <li>I hereby certify that I have read, understood and agreed to all the Terms and Conditions set forth on all two (2) pages of this Contract ...</li>
      </ol>
    </div>

    <div class="sign-row small">
      <div>DATE OF PURCHASE: <span class="underline">{!VM.purchaseDate}</span></div>
      <div>EXPIRATION DATE: <span class="underline">{!VM.expirationDate}</span></div>
    </div>
    <div class="sign-row small">
      <div>SELLING DEALER: <span class="underline">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></div>
      <div>APPLICANT: <span class="underline">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></div>
    </div>

    <!-- PAGE 2 -->
    <div class="page-break"></div>

    <h2>GAP Coverage (Guaranteed Asset Protection) – Service Agreement</h2>
    <div class="small">
      <p>A-Protect GAP Coverage is an optional program used for financed/leased vehicles. GAP Coverage is intended to protect you against most of the shortfall on your vehicle’s auto loan due to total loss. A-Protect will reimburse up to the maximum amount as indicated on Liability Coverage (Part 2) ...</p>
      <h3>Part 1) Definitions</h3>
      <p class="muted">Actual Cash Value, Amount Financed, Canadian Black Book Value, Claim, Claims Administrator, ... (full list reproduced from the contract)</p>

      <h3>Part 2) Financed Vehicle Coverage</h3>
      <p>2.1 Commencement and Expiry ... 2.2 Total Qualifying Amount ... 2.3 Loyalty Credit ... 2.4 Primary Insurance Policy ... 2.5 Transfers and Renewals ... 2.6 Cancellation and Termination ...</p>

      <h3>Part 3) GAP Policy Holder Responsibilities</h3>
      <ul>
        <li>Continue to make all applicable payments to the Financial Institution after the incident.</li>
        <li>Maintain the vehicle by adhering to the manufacturer maintenance schedule and keep all original service records.</li>
        <li>Do not continue to drive the vehicle after any damages or incidents to prevent further damage.</li>
        <li>Make reasonable efforts to recover a stolen vehicle (if applicable).</li>
        <li>Provide accurate information to A-Protect and its agents, etc.</li>
      </ul>

      <h3>Part 4) Claim Procedures</h3>
      <p>Call the Claims Administrator within 30 days from the date of Total Loss prior to accepting any settlement offers. Provide police report, proof of payment under Primary Insurance, claim report, proof of Outstanding Loan Amount, requisition form. Adjustments may apply for distance allowance overages, prior accidents, etc.</p>

      <h3>Part 5) GAP Coverage Exclusions</h3>
      <p>Includes (summarized): modified vehicles; no Primary Insurance; loss before delivery; >96 months; repossession; salvage/rebuilt; arrears; unlawful acts; non-Total Loss; unreported theft; >185,000 km; luxury/competition vehicles; nuclear/war/terrorism; commercial use, etc. Terms subject to change without notice.</p>

      <p class="small muted">INITIALS: __________</p>
    </div>

  </body>
  </html>
</apex:page>