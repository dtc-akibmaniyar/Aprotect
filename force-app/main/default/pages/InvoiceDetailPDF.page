<apex:page controller="InvoiceDetailPDFController" renderAs="pdf" showHeader="false" sidebar="false" standardStylesheets="false" applyBodyTag="false" applyHtmlTag="false">
    <html>
        <head>
            <style>
                @page {
                    size: A4;
                    margin: 15mm 14mm;
                    @bottom-center {
                        content: "Page " counter(page) " of " counter(pages);
                        font-size: 9px;
                        color: #666;
                    }
                }
                body {
                    font-family: Arial, sans-serif;
                    margin: 0;
                    padding: 0;
                    color: #111;
                    font-size: 12px;
                    line-height: 1.5;
                }
                table {
                    border-collapse: collapse;
                }
                /* Keep table header visible when the table splits across pages (best-effort) */
                thead {
                    display: table-header-group;
                }
                /* Avoid splitting rows / blocks across pages */
                tr {
                    page-break-inside: avoid;
                }
                .keep-together {
                    page-break-inside: avoid;
                }
            </style>
        </head>
        <body>

            <!-- ══════════════ HEADER: Logo (left) + INVOICE title block (right) ══════════════ -->
            <div style="display:table; width:100%; border-bottom:1px solid #e5e7eb;">
                <div style="display:table-cell; vertical-align:top; padding:20px 24px; border-right:1px solid #e5e7eb;">
                    <img src="{!$Resource.AProtectLogo}" alt="A-Protect Warranty Corporation"
                         style="max-height:70px; max-width:220px; margin-bottom:12px;"/>
                    <div style="font-size:11.5px; color:#555; line-height:1.8;">
                        <div>8800 Dufferin St. Suite 302B</div>
                        <div>Concord, Ontario L4K 0C5</div>
                        <div>TF: 1-866-660-6444&nbsp;&nbsp;Tel: 416-661-7444</div>
                        <div>E-mail: info@a-protectwarranty.com</div>
                        <div>HST #: 832142467RT0001</div>
                    </div>
                </div>
                <div style="display:table-cell; vertical-align:top; padding:20px 24px; text-align:right; width:300px;">
                    <div style="font-size:32px; font-weight:900; color:#1a3a6b; letter-spacing:4px; text-transform:uppercase; margin-bottom:16px; line-height:1;">INVOICE</div>
                    <table style="width:100%;">
                        <tr>
                            <td style="font-size:11px; font-weight:700; color:#555; text-transform:uppercase; padding:3px 10px 3px 0; white-space:nowrap; text-align:left;">INVOICE #</td>
                            <td style="font-size:15px; font-weight:700; color:#1a3a6b; text-align:right; padding:3px 0;">{!invoice.Name}</td>
                        </tr>
                        <tr>
                            <td style="font-size:11px; font-weight:700; color:#555; text-transform:uppercase; padding:3px 10px 3px 0; white-space:nowrap; text-align:left;">DATE:</td>
                            <td style="font-size:12px; color:#111; text-align:right; padding:3px 0;">{!invoiceDate}</td>
                        </tr>
                        <apex:outputPanel rendered="{!dueDate != null}" layout="none">
                            <tr>
                                <td style="font-size:11px; font-weight:700; color:#555; text-transform:uppercase; padding:3px 10px 3px 0; white-space:nowrap; text-align:left;">DUE DATE:</td>
                                <td style="font-size:12px; color:#111; text-align:right; padding:3px 0;">{!dueDate}</td>
                            </tr>
                        </apex:outputPanel>
                        <tr>
                            <td style="font-size:11px; font-weight:700; color:#555; text-transform:uppercase; padding:3px 10px 3px 0; white-space:nowrap; text-align:left;">STATUS:</td>
                            <td style="font-size:12px; text-align:right; padding:3px 0; {!statusStyle}">{!invoice.Status__c}</td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- ══════════════ DIVIDER ══════════════ -->
            <div style="height:3px; background:#1a3a6b; margin:0;"></div>

            <!-- ══════════════ BILL TO + VEHICLE ══════════════ -->
            <div style="display:table; width:100%; padding:16px 24px; border-bottom:1px solid #ddd;">
                <div style="display:table-cell; vertical-align:top; width:50%; padding-right:24px; border-right:1px solid #ddd;">
                    <div style="font-size:10px; font-weight:900; text-transform:uppercase; letter-spacing:1.5px; color:#1a3a6b; border-bottom:2px solid #1a3a6b; padding-bottom:4px; margin-bottom:10px;">BILL TO</div>
                    <apex:outputPanel rendered="{!hasDealerName}">
                        <div style="font-weight:700; font-size:13px; color:#111; text-transform:uppercase; margin-bottom:4px;">{!dealerName}</div>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!hasBillTo}">
                        <div style="font-size:12px; color:#333; line-height:1.7;">
                            <apex:outputText escape="false" value="{!billTo}"/>
                        </div>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!AND(!hasDealerName, !hasBillTo)}">
                        <div style="color:#aaa; font-style:italic; font-size:12px;">—</div>
                    </apex:outputPanel>
                </div>
                <div style="display:table-cell; vertical-align:top; width:50%; padding-left:24px;">
                    <div style="font-size:10px; font-weight:900; text-transform:uppercase; letter-spacing:1.5px; color:#1a3a6b; border-bottom:2px solid #1a3a6b; padding-bottom:4px; margin-bottom:10px;">VEHICLE</div>
                    <table style="font-size:12px;">
                        <tr>
                            <td style="font-weight:700; color:#444; white-space:nowrap; padding:2px 12px 2px 0;">Application (REF):</td>
                            <td style="color:#111; padding:2px 0;">{!applicationId}</td>
                        </tr>
                        <apex:outputPanel rendered="{!AND(customerFullName != null, customerFullName != '')}" layout="none">
                            <tr>
                                <td style="font-weight:700; color:#444; white-space:nowrap; padding:2px 12px 2px 0;">Customer:</td>
                                <td style="color:#111; font-weight:700; text-transform:uppercase; padding:2px 0;">{!customerFullName}</td>
                            </tr>
                        </apex:outputPanel>
                        <apex:outputPanel rendered="{!AND(vehicleInfo != null, vehicleInfo != '')}" layout="none">
                            <tr>
                                <td style="font-weight:700; color:#444; white-space:nowrap; padding:2px 12px 2px 0;">Year/Make/Model/Trim:</td>
                                <td style="color:#111; padding:2px 0;">{!vehicleInfo}</td>
                            </tr>
                        </apex:outputPanel>
                        <apex:outputPanel rendered="{!AND(vin != null, vin != '')}" layout="none">
                            <tr>
                                <td style="font-weight:700; color:#444; white-space:nowrap; padding:2px 12px 2px 0;">VIN #</td>
                                <td style="color:#111; padding:2px 0;">{!vin}</td>
                            </tr>
                        </apex:outputPanel>
                        <apex:outputPanel rendered="{!invoice.Application__r.Odometer__c != null}" layout="none">
                            <tr>
                                <td style="font-weight:700; color:#444; white-space:nowrap; padding:2px 12px 2px 0;">Odometer:</td>
                                <td style="color:#111; padding:2px 0;">
                                    <apex:outputText value="{0,number,###,##0}"><apex:param value="{!invoice.Application__r.Odometer__c}"/></apex:outputText> {!odometerUnit}
                                </td>
                            </tr>
                        </apex:outputPanel>
                    </table>
                </div>
            </div>

            <!-- ══════════════ LINE ITEMS TABLE ══════════════ -->
            <apex:outputPanel rendered="{!packages.size > 0}">
                <table style="width:100%; font-size:12px; margin-top:16px;">
                    <thead>
                        <tr style="background:#1a3a6b;">
                            <th style="padding:10px 14px; color:#fff; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; text-align:left; width:48%;">ITEM/DESCRIPTION</th>
                            <th style="padding:10px 14px; color:#fff; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; text-align:center; width:18%;">TERM</th>
                            <th style="padding:10px 14px; color:#fff; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; text-align:right; width:17%;">PRICE</th>
                            <th style="padding:10px 14px; color:#fff; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; text-align:right; width:17%;">SUB-TOTAL</th>
                        </tr>
                    </thead>
                    <tbody>
                        <apex:repeat var="row" value="{!packages}">
                            <!-- Category row -->
                            <tr style="background:#eef3fb;">
                                <td colspan="4" style="padding:6px 14px; font-size:11px; font-weight:700; color:#1a3a6b; text-transform:uppercase; letter-spacing:0.5px; border-bottom:1px solid #c5d7f0;">{!row.pkg.RecordType.Name}</td>
                            </tr>
                            <!-- Package row -->
                            <tr style="border-bottom:1px solid #e5e7eb;">
                                <td style="padding:10px 14px; vertical-align:top; color:#222;">
                                    <div style="font-weight:700; font-size:13px; color:#111; margin-bottom:2px;">{!row.pkg.Package__r.Name}</div>
                                </td>
                                <td style="padding:10px 14px; vertical-align:top; text-align:center; color:#444; white-space:nowrap;">{!row.termDisplay}</td>
                                <td style="padding:10px 14px; vertical-align:top; text-align:right; white-space:nowrap;">
                                    <apex:outputText value="${0,number,###,##0.00}"><apex:param value="{!row.baseCostPrice}"/></apex:outputText>
                                </td>
                                <td style="padding:10px 14px; vertical-align:top; text-align:right; font-weight:700; white-space:nowrap; border-left:1px solid #e5e7eb;">
                                    <apex:outputText value="${0,number,###,##0.00}"><apex:param value="{!row.lineTotal}"/></apex:outputText>
                                </td>
                            </tr>
                            <!-- Add-on rows -->
                            <apex:repeat var="opt" value="{!row.options}">
                                <tr style="background:#fafafa; border-bottom:1px solid #f0f0f0;">
                                    <td style="padding:10px 14px 10px 28px; font-size:12px; color:#555; vertical-align:top;">
                                        {!opt.optionName}
                                        <apex:outputPanel rendered="{!AND(opt.selectionType != null, opt.selectionType != '')}" layout="none">
                                            <span style="font-size:11px; color:#1a3a6b; font-style:italic; margin-left:4px;">({!opt.selectionType})</span>
                                        </apex:outputPanel>
                                    </td>
                                    <td style="padding:10px 14px; vertical-align:top; text-align:center; color:#444;">-</td>
                                    <td style="padding:10px 14px; vertical-align:top; text-align:right; white-space:nowrap;">
                                        <apex:outputText value="${0,number,###,##0.00}"><apex:param value="{!opt.costPrice}"/></apex:outputText>
                                    </td>
                                    <td style="padding:10px 14px; vertical-align:top; text-align:right; border-left:1px solid #e5e7eb;"></td>
                                </tr>
                            </apex:repeat>
                            <!-- Premium fee row -->
                            <apex:outputPanel rendered="{!row.hasPremiumModelFee}" layout="none">
                                <tr style="background:#fafafa; border-bottom:1px solid #f0f0f0;">
                                    <td style="padding:10px 14px 10px 28px; font-size:12px; color:#555; vertical-align:top;">
                                        Premium Vehicle Fee
                                        <span style="font-size:11px; color:#1a3a6b; font-style:italic; margin-left:4px;">(Fee)</span>
                                    </td>
                                    <td style="padding:10px 14px; vertical-align:top; text-align:center; color:#444;">-</td>
                                    <td style="padding:10px 14px; vertical-align:top; text-align:right; white-space:nowrap;">
                                        <apex:outputText value="${0,number,###,##0.00}"><apex:param value="{!row.premiumModelFee}"/></apex:outputText>
                                    </td>
                                    <td style="padding:10px 14px; vertical-align:top; text-align:right; border-left:1px solid #e5e7eb;"></td>
                                </tr>
                            </apex:outputPanel>
                        </apex:repeat>
                    </tbody>
                </table>
            </apex:outputPanel>

            <!-- ══════════════ TOTALS ══════════════ -->
            <div class="keep-together" style="display:table; width:100%; margin-top:16px; padding-top:16px; border-top:2px solid #1a3a6b;">
                <div style="display:table-cell; width:50%;"></div>
                <div style="display:table-cell; width:50%;">
                    <table style="width:100%;">
                        <tr>
                            <td style="font-size:13px; font-weight:700; color:#333; text-transform:uppercase; text-align:right; padding-right:20px; white-space:nowrap;">SUB-TOTAL:</td>
                            <td style="font-size:13px; font-weight:700; color:#111; text-align:right; white-space:nowrap;">
                                <apex:outputText value="${0,number,###,##0.00}"><apex:param value="{!subTotal}"/></apex:outputText>
                            </td>
                        </tr>
                        <tr>
                            <td style="font-size:13px; font-weight:700; color:#333; text-transform:uppercase; text-align:right; padding-right:20px; white-space:nowrap;">HST (ON) <apex:outputText rendered="{!blendedTaxRate != null}" value="{0,number,0.00}"><apex:param value="{!blendedTaxRate}"/></apex:outputText>%:</td>
                            <td style="font-size:13px; font-weight:700; color:#111; text-align:right; white-space:nowrap;">
                                <apex:outputText value="${0,number,###,##0.00}"><apex:param value="{!taxTotal}"/></apex:outputText>
                            </td>
                        </tr>
                        <tr>
                            <td style="font-size:15px; font-weight:700; color:#1a3a6b; text-transform:uppercase; text-align:right; padding-right:20px; white-space:nowrap; border-top:2px solid #1a3a6b; padding-top:6px;">TOTAL DUE:</td>
                            <td style="font-size:15px; font-weight:700; color:#1a3a6b; text-align:right; white-space:nowrap; border-top:2px solid #1a3a6b; padding-top:6px;">
                                <apex:outputText value="${0,number,###,##0.00}"><apex:param value="{!balanceAmount}"/></apex:outputText>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- ══════════════ BOTTOM ROW: Thank You (left) + Footer note (right) ══════════════ -->
            <div class="keep-together" style="display:table; width:100%; border-top:1px solid #e5e7eb; margin-top:20px;">
                <div style="display:table-cell; vertical-align:middle; width:30%; padding:20px 24px; border-right:1px solid #e5e7eb; text-align:center;">
                    <img src="{!$Resource.ThankYouBanner}" alt="Thank You for Your Business!" style="max-width:180px; height:auto;"/>
                </div>
                <div style="display:table-cell; vertical-align:middle; padding:18px 24px; font-size:11px; color:#555; line-height:1.8;">
                    <p style="margin:0 0 2px;">Please remit payment within 30 days of the invoice date.</p>
                    <p style="margin:0 0 2px;">Any cheque returned or dishonoured by a financial institution will be subject to a $5.00 Administration Fee.</p>
                    <p style="margin:0 0 2px;">Please make all cheques payable to <strong>A-Protect Warranty Corporation</strong>.</p>
                </div>
            </div>

        </body>
    </html>
</apex:page>