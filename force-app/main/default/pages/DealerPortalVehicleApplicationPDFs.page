  .ack { font-size: 8.1pt; font-weight: bold; color:#111111; margin: 10px 0 3px 0; }
  .rule { border-top: 0.7pt solid #c9cfda; margin: 0 0 5px 0; }
  table.sig { width:100%; border-collapse: collapse; margin-top: 16px; }
  table.sig td { width:50%; vertical-align: bottom; padding: 0 14px 0 0; }
  .sigline { border-top: 0.6pt solid #111111; height: 15px; }
  .siglab { font-size: 6.4pt; color:#3f4a5c; padding-top: 2px; }
