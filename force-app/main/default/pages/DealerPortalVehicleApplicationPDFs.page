<body>
<apex:repeat value="{!recordTypeWrappersList}" var="rw"><apex:repeat value="{!rw.packages}" var="w">
<apex:outputPanel rendered="{!NOT(w.isTireRim)}">



<table class="hdr"><tr>
  <td style="width:1.00in"><img src="{!$Resource.AProtectFullLogo}" style="width:0.93in" /></td>
  <td>
    <div class="doctitle">Extended Warranty Vehicle Service Contract</div>
    <div class="doccontact">1-866-660-6444 &#183; Tel: 416-661-7444 &#183; info@a-protectwarranty.com</div>
    <div class="doccontact">8800 Dufferin St. Suite 302B, Concord, ON L4K 0C5 &#183; HST #: 832142467RT0001</div>
  </td>
  <td style="width:1.15in; text-align:right;"><img src="{!$Resource.WarrantyHero}" style="width:1.05in" /></td>
  <td style="width:1.75in; padding-left:10px;">
    <div class="badge"><div class="bl">CONTRACT NO.</div><div class="bv">{!Application__c.Name}</div></div>
  </td>
</tr></table>
<div class="hdrrule"></div>
<div class="titlebar">APPLICATION</div>

<div class="sec"><span class="secnum">1</span><span class="sectitle">CONTRACT INFORMATION</span></div>
<div class="secrule"></div>
<div class="note">It is the responsibility of the Contract Holder to check that the coverage listed on this document agrees with the original Application given to You by the Selling Dealer. Any discrepancies must be reported to A-Protect immediately.</div>
<table class="kv">
  <tr><td class="lb">Contract Number</td><td class="vl">{!Application__c.Name}</td>
      <td class="lb2">Status</td><td class="vl2">{!Application__c.Application_Status__c}</td></tr>
  <tr><td class="lb">Program</td><td class="vl">{!w.renderedPlanName}</td>
      <td class="lb2">Term (months)</td><td class="vl2">{!w.renderedTermName}</td></tr>
  <tr><td class="lb">Per Claim Limit</td><td class="vl">{!w.perClaimLimitDisplay}</td>
      <td class="lb2">Deductible</td><td class="vl2">{!w.deductibleDisplay}</td></tr>
  <tr><td class="lb">Liability Limit</td><td class="vl">{!w.liabilityDisplay}</td>
      <td class="lb2">&#160;</td><td class="vl2">&#160;</td></tr>
  <tr><td class="lb">&#160;</td><td colspan="3" style="font-size:5.9pt; color:#3f4a5c; font-weight:normal;">Total liability equals the purchase price of the vehicle before taxes.</td></tr>
  <tr><td class="lb">Contract Start Date</td><td class="vl">{!w.contractStartDateDisplay}</td>
      <td class="lb2">Contract Expiration Date</td><td class="vl2">{!w.contractEndDateDisplay}</td></tr>
  <tr><td class="lb">Contract Start Odometer</td><td class="vl">{!w.odometerStartDisplay}</td>
      <td class="lb2">Contract Expiration Odometer</td><td class="vl2">{!w.odometerEndDisplay}</td></tr>
</table>
<table class="premium"><tr>
  <td>Contract Premium <b>{!w.premiumWithoutTaxDisplay}</b></td>
  <td>GST/HST <b>{!w.taxDisplay}</b></td>
  <td>PST/QST/RST <b>$0.00</b></td>
  <td class="totlab">Total Premium</td><td class="total">{!w.totalPremiumDisplay}</td>
</tr></table>
<div class="note" style="font-style:normal;">Coverage begins on the Contract Start Date and odometer reading listed above, and ends on the Contract Expiration Date or when the vehicle reaches the Contract Expiration Odometer reading, whichever comes first.</div>

<div class="sec"><span class="secnum">2</span><span class="sectitle">CUSTOMER / REGISTERED VEHICLE OWNER</span></div>
<div class="secrule"></div>
<table class="kv">
  <tr><td class="lb">Customer Name</td>
      <td class="vl"><apex:outputText value="{!UPPER(Application__c.Customer_Last_Name__c)}" /><apex:outputText value=", " rendered="{!NOT(ISBLANK(Application__c.Customer_First_Name__c))}" /><apex:outputText value="{!UPPER(Application__c.Customer_First_Name__c)}" /></td>
      <td class="lb2">Company / Business Name</td><td class="vl2">{!Application__c.Company_Business__c}</td></tr>
  <tr><td class="lb">Address</td><td colspan="3">{!Application__c.Customer_Address__c}</td></tr>
  <tr><td class="lb">Primary Phone</td><td class="vl">{!Application__c.Customer_Phone__c}</td>
      <td class="lb2">Secondary Phone</td><td class="vl2">{!Application__c.Customer_Business_Phone__c}</td></tr>
  <tr><td class="lb">Email</td><td class="vl">{!Application__c.Customer_Email__c}</td>
      <td class="lb2">Lienholder (if applicable)</td>
      <td class="vl2">{!Application__c.Financial_Institution_Lender__c}<span class="ln2">{!Application__c.Lender_Address__c}</span></td></tr>
  <tr><td class="lb">Secondary Owner Name</td><td class="vl">{!Application__c.Co_Buyer__r.Name}</td>
      <td class="lb2">Secondary Owner Email</td><td class="vl2">&#160;</td></tr>
</table>

<div class="sec"><span class="secnum">3</span><span class="sectitle">VEHICLE</span></div>
<div class="secrule"></div>
<table class="kv4">
  <tr><td class="lb">Year</td><td class="vl">{!Application__c.Vehicle_Year__c}</td>
