<apex:page standardController="Application__c" extensions="ApplicationPDFExtension" renderAs="pdf" applyBodyTag="false" applyHtmlTag="false" showHeader="false" cache="false" standardStylesheets="false">
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
    <style type="text/css">
        @page {
            size: letter;
            margin: 0.45in 0.5in 0.55in 0.5in;
            @bottom-left {
                content: "{!$Label.Application_PDF_Footer_Contract_Number_Label} {!Application__c.Name}  |  {!$Label.Application_PDF_Footer_Application_Number_Label} {!Application__c.Name}  |  {!$Label.Application_PDF_Footer_GST_HST_Label} 832142467RT0001";
                font-family: Arial, Helvetica, sans-serif;
                font-size: 6.5pt;
                color: #000;
                border-top: 1px solid #999;
                padding-top: 3px;
                vertical-align: top;
                width: 70%;
            }
            @bottom-right {
                content: "{!$Label.Application_PDF_Footer_Page} " counter(page) " {!$Label.Application_PDF_Footer_Of} " counter(pages) "  |  {!$Label.Application_PDF_Footer_Printed_On} {!printedOn}";
                font-family: Arial, Helvetica, sans-serif;
                font-size: 6.5pt;
                color: #000;
                border-top: 1px solid #999;
                padding-top: 3px;
                vertical-align: top;
                text-align: right;
                width: 30%;
            }
        }
        * { box-sizing: border-box; }
        body { font-family: Arial, Helvetica, sans-serif; font-size: 8.5pt; line-height: 1.3; color: #000; margin: 0; padding: 0; }
        .header-wrap { width: 100%; border-collapse: collapse; margin-bottom: 6px; }
        .logo-cell { width: 50%; vertical-align: top; }
        .logo-info { font-size: 7.5pt; margin-top: 5px; line-height: 1.5; }
        .title-cell { width: 50%; vertical-align: top; text-align: right; }
        .doc-title  { font-size: 12pt; font-weight: bold; color: #5184B8; }
        .doc-notice { font-size: 7pt; margin-top: 5px; line-height: 1.4; }
        .privacy { background: #f2f2f2; border: 1px solid #bbb; padding: 5px 7px; font-size: 6.8pt; line-height: 1.4; margin-bottom: 8px; }
        .sec-hdr { background-color: #5184B8; color: #fff; font-weight: bold; font-size: 8.5pt; padding: 4px 7px; margin: 9px 0 3px 0; }
        .sub-hdr { background-color: #5184B8; color: #fff; font-weight: bold; font-size: 8pt; padding: 3px 7px; margin: 7px 0 3px 0; }
        .dtbl { width: 100%; border-collapse: collapse; margin-bottom: 5px; border: 1px solid #aaa; }
        .dtbl td { border: 1px solid #aaa; padding: 3px 5px; vertical-align: top; font-size: 8pt; }
        .lbl { font-weight: bold; background: #f5f5f5; width: 23%; white-space: nowrap; }
        .val { width: 27%; }
        .note { font-size: 7.5pt; margin: 4px 0; }
        .bold { font-weight: bold; }
        .ital { font-style: italic; }
        ul { margin: 3px 0 3px 16px; padding: 0; }
        ol { margin: 3px 0 3px 8px; padding: 0 0 0 20px; }
        li { margin: 2px 0; font-size: 8pt; }
        p  { margin: 4px 0; font-size: 8pt; }
        .center { text-align: center; }
        .tc-body { font-size: 7.8pt; line-height: 1.4; }
        .cov-name { font-weight: bold; font-size: 8pt; margin-top: 5px; }
        .indent { margin-left: 10px; }
        .page-break { page-break-after: always; }
    </style>
</head>
<body>
<apex:repeat value="{!recordTypeWrappersList}" var="recordTypeWrapper">
    <apex:repeat value="{!recordTypeWrapper.packages}" var="wrapper">

        <!-- ==================== HEADER ==================== -->
        <table class="header-wrap">
            <tr>
                <td class="logo-cell">
                    <apex:outputPanel layout="none" rendered="{!hasDealerLogo}">
                        <img src="{!dealerLogoUrl}" style="width:133px; height:auto;" alt="{!dealerName}"/>
                    </apex:outputPanel>
                    <apex:outputPanel layout="none" rendered="{!NOT(hasDealerLogo)}">
                        <img src="{!URLFOR($Resource.AProtectLogo)}" style="width:133px; height:auto;" alt="{!$Label.Application_PDF_Company_Name}"/>
                    </apex:outputPanel>
                    <div class="logo-info" style="margin-top:5px;">
                        <apex:outputPanel layout="none" rendered="{!hasDealerLogo}">
                            {!dealerName}<br/>
                            {!dealerAddress}<br/>
                            Tel: {!dealerPhone}<br/>
                            {!dealerEmail}
                        </apex:outputPanel>
                        <apex:outputPanel layout="none" rendered="{!NOT(hasDealerLogo)}">
                            {!$Label.Application_PDF_Company_Address_Line1}<br/>
                            {!$Label.Application_PDF_Company_Address_Line2}<br/>
                            {!$Label.Application_PDF_Company_Phone}<br/>
                            {!$Label.Application_PDF_Company_Email}<br/>
                            {!$Label.Application_PDF_HST_Label} 832142467RT0001
                        </apex:outputPanel>
                    </div>
                </td>
                <td class="title-cell">
                    <div class="doc-title">{!$Label.Application_PDF_Document_Title}</div>
                    <div class="doc-notice">
                        {!$Label.Application_PDF_Document_Notice}
                    </div>
                </td>
            </tr>
        </table>

        <div class="privacy">
            <span class="bold">{!$Label.Application_PDF_Privacy_Notice_Title}</span> {!$Label.Application_PDF_Privacy_Notice_Body}
        </div>

        <!-- ==================== SECTION 1: CONTRACT INFORMATION ==================== -->
        <div class="sec-hdr">{!$Label.Application_PDF_Section1_Title}</div>
        <table class="dtbl">
            <tr>
                <td class="lbl">{!$Label.Application_PDF_Contract_Number_Label}</td><td class="val">{!Application__c.Name}</td>
                <td class="lbl">{!$Label.Application_PDF_Status_Label}</td><td class="val">{!Application__c.Application_Status__c}</td>
            </tr>
            <tr>
                <td class="lbl">{!$Label.Application_PDF_Program_Label}</td><td class="val">{!wrapper.renderedPlanName}</td>
                <td class="lbl">{!$Label.Application_PDF_Term_Label}</td><td class="val">{!wrapper.renderedTermName}</td>
            </tr>
            <tr>
                <td class="lbl">{!$Label.Application_PDF_Mileage_Label}</td><td class="val">{!wrapper.mileageDisplay}</td>
                <td class="lbl">{!$Label.Application_PDF_Deductible_Label}</td><td class="val">{!wrapper.deductibleDisplay}</td>
            </tr>
            <tr>
                <td class="lbl">{!$Label.Application_PDF_Per_Claim_Limit_Label}</td><td class="val">{!wrapper.perClaimLimitDisplay}</td>
                <td class="lbl">{!$Label.Application_PDF_Liability_Limit_Label}</td>
                <td class="val">{!wrapper.liabilityDisplay} <span style="font-size:6.8pt;">{!$Label.Application_PDF_Liability_Note}</span></td>
            </tr>
            <tr>
                <td class="lbl">{!$Label.Application_PDF_Premium_Label}</td><td class="val">{!wrapper.premiumWithoutTaxDisplay}</td>
                <td class="lbl">{!$Label.Application_PDF_Premium_Plus_Tax_Label}</td><td class="val">{!wrapper.taxDisplay}</td>
            </tr>
            <tr>
                <td class="lbl">{!$Label.Application_PDF_PST_QST_RST_Label}</td><td class="val">$0.00</td>
                <td class="lbl">{!$Label.Application_PDF_Total_Premium_Label}</td><td class="val"><span class="bold">{!wrapper.totalPremiumDisplay}</span></td>
            </tr>
            <tr>
                <td class="lbl">{!$Label.Application_PDF_Commencement_Date_Label}</td><td class="val">{!wrapper.contractStartDateDisplay}</td>
                <td class="lbl">{!$Label.Application_PDF_Expiration_Date_Label}</td><td class="val">{!wrapper.contractEndDateDisplay}</td>
            </tr>
            <tr>
                <td class="lbl">{!$Label.Application_PDF_Commencement_Odometer_Label}</td><td class="val">{!wrapper.odometerStartDisplay}</td>
                <td class="lbl">{!$Label.Application_PDF_Expiration_Odometer_Label}</td><td class="val">{!wrapper.odometerEndDisplay}</td>
            </tr>
        </table>
        <div class="note">{!$Label.Application_PDF_Section1_Note}</div>

        <!-- ==================== SECTION 2: REGISTERED OWNER ==================== -->
        <div class="sec-hdr">{!$Label.Application_PDF_Section2_Title}</div>
        <table class="dtbl">
            <tr><td class="lbl">{!$Label.Application_PDF_Owner_Name_Label}</td><td colspan="3">{!Application__c.Customer_Last_Name__c}, {!Application__c.Customer_First_Name__c}</td></tr>
            <tr><td class="lbl">{!$Label.Application_PDF_Owner_Address_Label}</td><td colspan="3">{!Application__c.Customer_Address__c}</td></tr>
            <tr>
                <td class="lbl">{!$Label.Application_PDF_Owner_Primary_Phone_Label}</td><td class="val">{!Application__c.Customer_Phone__c}</td>
                <td class="lbl">{!$Label.Application_PDF_Owner_Secondary_Phone_Label}</td><td>{!Application__c.Customer_Business_Phone__c}</td>
            </tr>
            <tr>
                <td class="lbl">{!$Label.Application_PDF_Owner_Email_Label}</td><td class="val">{!Application__c.Customer_Email__c}</td>
                <td class="lbl">{!$Label.Application_PDF_Owner_Lienholder_Label}</td><td>{!Application__c.Financial_Institution_Lender__c}</td>
            </tr>
        </table>

        <!-- ==================== SECTION 3: VEHICLE ==================== -->
        <div class="sec-hdr">{!$Label.Application_PDF_Section3_Title}</div>
        <table class="dtbl">
            <tr><td class="lbl">{!$Label.Application_PDF_Vehicle_VIN_Label}</td><td colspan="3">{!Application__c.Vehicle_VIN__c}</td></tr>
            <tr>
                <td class="lbl">{!$Label.Application_PDF_Vehicle_Year_Label}</td><td class="val">{!Application__c.Vehicle_Year__c}</td>
                <td class="lbl">{!$Label.Application_PDF_Vehicle_Make_Label}</td><td>{!Application__c.Vehicle_Make__c}</td>
            </tr>
            <tr>
                <td class="lbl">{!$Label.Application_PDF_Vehicle_Model_Label}</td><td class="val">{!Application__c.Vehicle_Model__c}</td>
                <td class="lbl">{!$Label.Application_PDF_Vehicle_Purchase_Price_Label}</td>
                <td>$<apex:outputText value="{0,number,###,##0.00}"><apex:param value="{!Application__c.Vehicle_Purchase_Price__c}"/></apex:outputText></td>
            </tr>
            <tr>
                <td class="lbl">{!$Label.Application_PDF_Vehicle_Odometer_Label}</td>
                <td class="val"><apex:outputText value="{0,number,###,###}"><apex:param value="{!Application__c.Odometer__c}"/></apex:outputText>&#160;{!Application__c.Odometer_Unit__c}</td>
                <td></td><td></td>
            </tr>
        </table>
        <div class="note">{!$Label.Application_PDF_Section3_Note}</div>

        <!-- ==================== PACKAGE DETAILS (record-type branch) ==================== -->
        <apex:outputPanel layout="none" rendered="{!NOT(wrapper.isTireRim)}">
            <div class="sub-hdr">Manufacturer Warranty</div>
            <table class="dtbl">
                <tr>
                    <td class="lbl">Warranty Type:</td><td class="val">{!Application__c.Vehicle__r.Manufacturer_Warranty_Type__c}</td>
                    <td class="lbl">Warranty Term:</td><td>{!Application__c.Vehicle__r.Warranty_Term__c}</td>
                </tr>
                <tr>
                    <td class="lbl">In-Service Date:</td>
                    <td class="val"><apex:outputText value="{0,date,MMM d, yyyy}"><apex:param value="{!Application__c.Vehicle__r.In_Service_Date__c}"/></apex:outputText></td>
                    <td class="lbl"></td><td></td>
                </tr>
            </table>
        </apex:outputPanel>
        <apex:outputPanel layout="none" rendered="{!wrapper.isTireRim}">
            <div class="sub-hdr">Tire &amp; Rim Details</div>
            <table class="dtbl">
                <tr>
                    <td class="lbl">Tire Brand:</td><td class="val">{!wrapper.pkg.Tire_Brand__c}</td>
                    <td class="lbl">Tire Type:</td><td>{!wrapper.pkg.Tire_Type__c}</td>
                </tr>
                <tr>
                    <td class="lbl">Tread Depth:</td><td class="val">{!wrapper.pkg.Tread_Depth__c}&#160;{!wrapper.pkg.Tread_Depth_Unit__c}</td>
                    <td class="lbl">Rim Brand:</td><td>{!wrapper.pkg.Rim_Brand__c}</td>
                </tr>
                <tr>
                    <td class="lbl">Rim Type:</td><td class="val">{!wrapper.pkg.Rim_Type__c}</td>
                    <td class="lbl">Rim Size:</td><td>{!wrapper.pkg.Rim_Size__c}&#160;{!wrapper.pkg.Rim_Size_Unit__c}</td>
                </tr>
            </table>
        </apex:outputPanel>

        <!-- ==================== SECTION 4: CUSTOMER OBLIGATIONS ==================== -->
        <div class="sec-hdr">{!$Label.Application_PDF_Section4_Title}</div>
        <p><span class="bold ital">{!$Label.Application_PDF_Important_Notice}</span></p>
        <p>{!$Label.Application_PDF_Maintenance_Intro}</p>
        <ul>
            <li><span class="bold">{!$Label.Application_PDF_Obligation_Oil_Change}</span></li>
            <li><span class="bold">{!$Label.Application_PDF_Obligation_Fluid_Levels}</span><br/>
                <span style="font-size:7.5pt;">{!$Label.Application_PDF_Obligation_Fluid_Note}</span>
            </li>
        </ul>
        <p class="bold">{!$Label.Application_PDF_Maintenance_Reporting_Intro}</p>
        <ul>
            <li><span class="bold">{!$Label.Application_PDF_Website_Method_Label}</span> {!$Label.Application_PDF_Website_Method_Instruction}</li>
            <li><span class="bold">{!$Label.Application_PDF_Email_Method_Label}</span> {!$Label.Application_PDF_Email_Method_Instruction}</li>
            <li><span class="bold">{!$Label.Application_PDF_Mail_Method_Label}</span> {!$Label.Application_PDF_Mail_Method_Instruction}</li>
        </ul>
        <p>{!$Label.Application_PDF_Keep_Invoices_Notice}</p>
        <p class="bold">{!$Label.Application_PDF_DIY_Oil_Change_Notice}</p>
        <p class="bold">{!$Label.Application_PDF_Non_Compliance_Notice}</p>
        <p><span class="bold">A.</span> {!$Label.Application_PDF_Certification_Line1}</p>
        <p><span class="bold">B.</span> {!$Label.Application_PDF_Certification_Line2}</p>
        <ol>
            <li>{!$Label.Application_PDF_Certification_Item1}</li>
            <li>{!$Label.Application_PDF_Certification_Item2}</li>
            <li>{!$Label.Application_PDF_Certification_Item3}</li>
            <li>{!$Label.Application_PDF_Certification_Item4}</li>
            <li>{!$Label.Application_PDF_Certification_Item5}</li>
        </ol>
        <p class="bold">{!$Label.Application_PDF_Misleading_Info_Notice}</p>
        <p>{!$Label.Application_PDF_Dealer_Certification}</p>

        <!-- ==================== DEALER INFORMATION ==================== -->
        <div class="sub-hdr">{!$Label.Application_PDF_Dealer_Information_Title}</div>
        <table class="dtbl">
            <tr>
                <td class="lbl">{!$Label.Application_PDF_Dealer_Name_Label}</td><td class="val">{!Application__c.Dealer_Name__r.Name}</td>
                <td class="lbl">{!$Label.Application_PDF_Dealership_Registration_Label}</td><td>&#160;</td>
            </tr>
            <tr><td class="lbl">{!$Label.Application_PDF_Dealer_Address_Label}</td><td colspan="3">{!dealerAddress}</td></tr>
            <tr>
                <td class="lbl">{!$Label.Application_PDF_Salesperson_Label}</td><td class="val">{!Application__c.Sales_Person__r.Name}</td>
                <td class="lbl">{!$Label.Application_PDF_Salesperson_Registration_Label}</td><td>{!Application__c.Dealer_Sales_ID_License__c}</td>
            </tr>
            <tr>
                <td class="lbl">{!$Label.Application_PDF_Dealer_Signature_Label}</td><td class="val">&#160;</td>
                <td class="lbl">{!$Label.Application_PDF_Customer_Signature_Label}</td><td>&#160;</td>
            </tr>
        </table>

        <!-- ==================== TERMS AND CONDITIONS ==================== -->
        <div class="center" style="font-size:10pt;font-weight:bold;margin:10px 0 6px 0;text-decoration:underline;">{!$Label.Application_PDF_TC_Title}</div>

        <!-- Dealer / package-specific Terms and Conditions -->
        <apex:outputPanel layout="none" rendered="{!wrapper.hasTermsAndConditions}">
            <div class="sub-hdr">Dealer Terms and Conditions</div>
            <div class="tc-body">
                <apex:outputText value="{!wrapper.termsAndConditions}" escape="false"/>
            </div>
        </apex:outputPanel>

        <div class="tc-body">
            <p>{!$Label.Application_PDF_TC_Intro1}</p>
            <p>{!$Label.Application_PDF_TC_Intro2}</p>
            <p>{!$Label.Application_PDF_TC_Intro3}</p>
            <p>{!$Label.Application_PDF_TC_Intro4}</p>
            <p>{!$Label.Application_PDF_TC_Intro5}</p>
        </div>

        <div class="sub-hdr">{!$Label.Application_PDF_TC_Covered_Services_Title}</div>
        <div class="tc-body">
            <p class="cov-name">{!$Label.Application_PDF_Coverage_AirBags_Title}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_AirBags_Includes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_Brakes_Title}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_Brakes_Includes}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Excludes_Label}</span> {!$Label.Application_PDF_Coverage_Brakes_Excludes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_BreakdownAwayFromHome_Title}</p>
            <p class="indent">{!$Label.Application_PDF_Coverage_BreakdownAwayFromHome_Description}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_BreakdownAwayFromHome_Includes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_CarRental_Title}</p>
            <p class="indent">{!$Label.Application_PDF_Coverage_CarRental_Description}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_CarRental_Includes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_CoolingSystem_Title}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_CoolingSystem_Includes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_Differential_Title}</p>
            <p class="indent">{!$Label.Application_PDF_Coverage_Differential_Description}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_Differential_Includes}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Excludes_Label}</span> {!$Label.Application_PDF_Coverage_Differential_Excludes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_Driveline_Title}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_Driveline_Includes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_Electrical_Title}</p>
            <p class="indent">{!$Label.Application_PDF_Coverage_Electrical_Description}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_Electrical_Includes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_Engine_Title}</p>
            <p class="indent">{!$Label.Application_PDF_Coverage_Engine_Description}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_Engine_Includes}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Excludes_Label}</span> {!$Label.Application_PDF_Coverage_Engine_Excludes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_EngineEmission_Title}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_EngineEmission_Includes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_FluidsFilters_Title}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_FluidsFilters_Includes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_FuelSystem_Title}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_FuelSystem_Includes}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Excludes_Label}</span> {!$Label.Application_PDF_Coverage_FuelSystem_Excludes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_HVAC_Title}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_HVAC_Includes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_RoadsideAssistance_Title}</p>
            <p class="indent">{!$Label.Application_PDF_Coverage_RoadsideAssistance_Description}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_RoadsideAssistance_Includes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_SealsGaskets_Title}</p>
            <p class="indent">{!$Label.Application_PDF_Coverage_SealsGaskets_Description}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_SealsGaskets_Includes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_Steering_Title}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_Steering_Includes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_SuspensionFront_Title}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_SuspensionFront_Includes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_SuspensionRear_Title}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_SuspensionRear_Includes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_TechnologyEquipment_Title}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_TechnologyEquipment_Includes_Part1}, {!$Label.Application_PDF_Coverage_TechnologyEquipment_Includes_Part2}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_TransferCase_Title}</p>
            <p class="indent">{!$Label.Application_PDF_Coverage_TransferCase_Description}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_TransferCase_Includes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_Transmission_Title}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Includes_Label}</span> {!$Label.Application_PDF_Coverage_Transmission_Includes}</p>
            <p class="indent"><span class="bold">{!$Label.Application_PDF_Coverage_Excludes_Label}</span> {!$Label.Application_PDF_Coverage_Transmission_Excludes}</p>
            <p class="cov-name">{!$Label.Application_PDF_Coverage_TurboSupercharger_Title}</p>
