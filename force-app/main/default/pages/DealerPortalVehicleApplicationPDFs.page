  table.contact td.c2 { border-right: 0.5pt solid #c9cfda; width: 32%; }
  .clab { font-size: 5.4pt; letter-spacing: 0.8pt; color:#506590; font-weight: bold; text-transform: uppercase; }
  .cval { font-size: 9.2pt; font-weight: bold; color:#111111; }
