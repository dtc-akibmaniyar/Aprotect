<apex:page standardController="Application__c" extensions="ApplicationPDFExtension" renderAs="pdf" applyBodyTag="false" showHeader="false">

    <head>
        <style type="text/css" media="print">
            @page {
                size: letter;
                margin: 0.35in 0.4in 0.55in 0.4in;

                @bottom-center {
                    content: element(footer);
                }
            }

            div.footer {
                display: block;
                padding: 3px 0;
                position: running(footer);
                font-size: 7.5pt;
                text-align: center;
                color: #333;
                font-family: Arial, Helvetica, sans-serif;
                border-top: 1px solid #999;
            }

            .pagenumber:before {
                content: counter(page);
            }

            .pagecount:before {
                content: counter(pages);
            }
        </style>
    </head>

    <style type="text/css">
        body, table, td, th, div, span, p {
            font-family: Arial, Helvetica, sans-serif;
        }
        body {
            margin: 0;
            padding: 0;
            color: #000;
            font-size: 9pt;
            line-height: 1.35;
        }
        .page-break { page-break-after: always; }

        /* Section header bar - dark navy */
        .section-header {
            background: #1a1a2e;
            color: white;
            padding: 5px 10px;
            font-weight: bold;
            font-size: 8pt;
            margin-top: 10px;
            margin-bottom: 0;
            letter-spacing: 0.5px;
        }

        /* Sub-header blue label */
        .sub-label {
            font-weight: bold;
            color: #4472C4;
            font-size: 7.5pt;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            margin-bottom: 2px;
        }

        /* Terms and Conditions styles */
        .tc-body {
            font-size: 9pt;
            line-height: 1.5;
            text-align: justify;
            color: #222;
        }
        .tc-body p { margin: 5px 0; }
        .tc-body h1, .tc-body h2, .tc-body h3 {
            font-size: 10pt;
            margin: 10px 0 5px 0;
            font-weight: bold;
            color: #000;
        }
        .tc-body ol, .tc-body ul { margin: 5px 0; padding-left: 18px; }
        .tc-body li { margin: 2px 0; }
    </style>

    <!-- FOOTER -->
    <div class="footer">
        <div style="font-weight:bold;">A-Protect Warranty Corporation</div>
        <div>8800 Dufferin St. Suite 302B Concord, ON L4K 1Z8 | Toll Free: 1-866-660-6444 | Tel: 416-661-6444 | www.a-protectwarranty.com</div>
    </div>

    <div>
        <apex:repeat value="{!recordTypeWrappersList}" var="recordTypeWrapper">
            <apex:repeat value="{!recordTypeWrapper.packages}" var="wrapper">

                <!-- ======================== PAGE: APPLICATION FORM ======================== -->

                <!-- HEADER -->
                <table style="width:100%; border-collapse:collapse; margin-bottom:0;">
                    <tr>
                        <!-- Title Left -->
                        <td style="width:70%; vertical-align:top; padding:0;">
                            <apex:outputPanel rendered="{!wrapper.isTireRim}">
                                <div style="font-size:19pt; font-weight:bold; color:#1a1a2e; line-height:1.15;">Tire &amp; Rim Warranty Application</div>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!NOT(wrapper.isTireRim)}">
                                <div style="font-size:19pt; font-weight:bold; color:#1a1a2e; line-height:1.15;">Extended Limited Warranty Application</div>
                            </apex:outputPanel>
                            <div style="font-size:14pt; color:#555; margin-top:1px;">Vehicle Service Contract</div>
                        </td>
                        <!-- Application # Right -->
                        <td style="width:30%; text-align:right; vertical-align:top; padding:0;">
                            <div style="font-size:12pt; color:#666;">Application #</div>
                            <div style="font-size:18pt; font-weight:bold; color:#1a1a2e;">{!Application__c.Name}</div>
                        </td>
                    </tr>
                </table>

                <!-- ===== SECTION 1: CUSTOMER INFORMATION ===== -->
                <div class="section-header">SECTION 1: CUSTOMER INFORMATION</div>
                <table style="width:100%; border-collapse:collapse; border:1px solid #ccc; border-top:none;">
                    <tr>
                        <!-- Primary Owner -->
                        <td style="width:33%; padding:5px 8px; vertical-align:top; font-size:9pt; border-right:1px solid #ddd;">
                            <div style="font-weight:bold; font-size:9pt;">{!Application__c.Customer_First_Name__c} {!Application__c.Customer_Last_Name__c}</div>
                            <div>{!Application__c.Customer_Address__c}</div>
                            <div>Tel: {!Application__c.Customer_Phone__c}</div>
                            <div>E-mail: {!Application__c.Customer_Email__c}</div>
                        </td>
                        <!-- Co-Buyer -->
                        <td style="width:33%; padding:5px 8px; vertical-align:top; font-size:9pt; border-right:1px solid #ddd;">
                            <div style="font-weight:bold; font-size:9pt;">{!Application__c.Co_Buyer__r.Name}</div>
                            <div>{!Application__c.Co_Buyer__r.BillingStreet}</div>
                            <div>Tel: {!Application__c.Co_Buyer__r.Phone}</div>
                            <div>E-mail: {!Application__c.Co_Buyer__r.PersonEmail}</div>
                        </td>
                        <!-- Company/Business -->
                        <td style="width:34%; padding:5px 8px; vertical-align:top; font-size:9pt;">
                            <div style="font-weight:bold; font-size:9pt;">{!Application__c.Customer_Name__r.Name}</div>
                            <div>{!Application__c.Customer_Name__r.BillingStreet} {!Application__c.Customer_Name__r.BillingCity} {!Application__c.Customer_Name__r.BillingState} {!Application__c.Customer_Name__r.BillingPostalCode}</div>
                            <div>Contact Name: {!Application__c.Customer_First_Name__c}</div>
                            <div>Tel: {!Application__c.Customer_Phone__c}</div>
                            <div>E-mail: {!Application__c.Customer_Email__c}</div>
                        </td>
                    </tr>
                </table>

                <!-- ===== SECTION 2: VEHICLE INFORMATION ===== -->
                <div class="section-header">SECTION 2: VEHICLE INFORMATION</div>
                <table style="width:100%; border-collapse:collapse; border:1px solid #ccc; border-top:none;">
                    <tr>
                        <!-- Vehicle Details (left column ~33%) -->
                        <td style="width:33%; padding:5px 8px; vertical-align:top; font-size:9pt; border-right:1px solid #ddd;">
                            <div style="font-weight:bold; font-size:9pt; margin-bottom:2px;">{!Application__c.Vehicle_Year__c} {!Application__c.Vehicle_Make__c} {!Application__c.Vehicle_Model__c}</div>
                            <div>VIN#: {!Application__c.Vehicle_VIN__c}</div>
                            <div>Odometer: <apex:outputText value="{0,number,###,###}">
                                <apex:param value="{!Application__c.Odometer__c}" />
                            </apex:outputText> {!Application__c.Odometer_Unit__c}</div>
                            <div>Purchase Price: $<apex:outputText value="{0,number,###,##0.00}">
                                <apex:param value="{!Application__c.Vehicle_Purchase_Price__c}" />
                            </apex:outputText></div>
                            <div>Delivery Date: <apex:outputText value="{0,date,MM-dd-yyyy}">
                                <apex:param value="{!Application__c.Vehicle__r.Delivery_Date__c}" />
                            </apex:outputText></div>
                            <div style="height:8px;"></div>
                            <div>Transmission: {!Application__c.Vehicle__r.Transmission__c}</div>
                            <div>Fuel: {!Application__c.Vehicle__r.Fuel_Type__c}</div>
                            <div>Engine Size: {!Application__c.Vehicle__r.Engine__c}</div>
                            <div>Colour: {!Application__c.Vehicle__r.Color__c}</div>
                            <div>Body Type: {!Application__c.Vehicle__r.Body_Type__c}</div>
                            <div>Business/Commercial Use: {!Application__c.Vehicle__r.Business_Commercial_Use__c}</div>
                        </td>

                        <!-- Middle column (~33%): Manufacturer Warranty OR Tire Details -->
                        <td style="width:33%; padding:5px 8px; vertical-align:top; font-size:9pt; border-right:1px solid #ddd;">
                            <apex:outputPanel rendered="{!NOT(wrapper.isTireRim)}">
                                <div class="sub-label">Manufacturer Warranty:</div>
                                <div style="height:4px;"></div>
                                <div>Type: {!Application__c.Vehicle__r.Manufacturer_Warranty_Type__c}</div>
                                <div>Term: {!Application__c.Vehicle__r.Warranty_Term__c}</div>
                                <div>In-Service Date: <apex:outputText value="{0,date,MM-dd-yyyy}">
                                    <apex:param value="{!Application__c.Vehicle__r.In_Service_Date__c}" />
                                </apex:outputText></div>
                                <div style="height:16px;"></div>
                                <div class="sub-label">Dealer Notes:</div>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!wrapper.isTireRim}">
                                <div class="sub-label">Tire Details</div>
                                <div style="height:4px;"></div>
                                <div>Tire Brand: {!wrapper.pkg.Tire_Brand__c}</div>
                                <div>Tire Type: {!wrapper.pkg.Tire_Type__c}</div>
                                <div>Tread Depth: {!wrapper.pkg.Tread_Depth__c} {!wrapper.pkg.Tread_Depth_Unit__c}</div>
                                <div>Rim Brand: {!wrapper.pkg.Rim_Brand__c}</div>
                                <div>Rim Type: {!wrapper.pkg.Rim_Type__c}</div>
                                <div>Rim Size: {!wrapper.pkg.Rim_Size__c} {!wrapper.pkg.Rim_Size_Unit__c}</div>
                                <div style="height:10px;"></div>
                                <div class="sub-label">Dealer Notes:</div>
                            </apex:outputPanel>
                        </td>

                        <!-- Right column (~34%): Dealership + Lender -->
                        <td style="width:34%; padding:5px 8px; vertical-align:top; font-size:9pt;">
                            <div class="sub-label">Dealership Information</div>
                            <div style="height:4px;"></div>
                            <div style="font-weight:bold;">{!Application__c.Dealer_Name__r.Name}</div>
                            <div>{!Application__c.Dealer_Name__r.BillingStreet} {!Application__c.Dealer_Name__r.BillingCity} {!Application__c.Dealer_Name__r.BillingState} {!Application__c.Dealer_Name__r.BillingPostalCode}</div>
                            <div>Tel: {!Application__c.Dealer_Phone__c}</div>

                            <div style="height:12px;"></div>
                            <div class="sub-label">Lender Information</div>
                            <div style="height:4px;"></div>
                            <div style="font-weight:bold;">{!Application__c.Financial_Institution_Lender__c}</div>
                            <div>{!Application__c.Lender_Address__c}</div>
                            <div>Tel: </div>
                        </td>
                    </tr>
                </table>

                <!-- ===== SECTION 3: SERVICE PLAN SELECTIONS ===== -->
                <div class="section-header">SECTION 3: SERVICE PLAN SELECTIONS</div>
                <table style="width:100%; border-collapse:collapse; border:1px solid #ccc; border-top:none;">
                    <tr>
                        <!-- Package Logo area (left ~25%) -->
                        <td style="width:25%; padding:8px; vertical-align:middle; text-align:center;">
                            <apex:outputPanel rendered="{!wrapper.hasPackageLogo}">
                                <img src="{!wrapper.packageLogoUrl}" width="100" />
                            </apex:outputPanel>
                        </td>

                        <!-- Plan Information (center ~75%) -->
                        <td style="width:75%; padding:6px 8px; vertical-align:top;">
                            <div style="font-weight:bold; font-size:7pt; color:#1a1a2e; margin-bottom:4px; letter-spacing:0.3px;">PLAN INFORMATION</div>
                            <table style="border-collapse:collapse; width:100%;">
                                <tr>
                                    <td style="font-weight:bold; font-size:8pt; padding:1px 6px 1px 0; white-space:nowrap; vertical-align:top;">Plan Name:</td>
                                    <td style="font-size:9pt; padding:1px 0; vertical-align:top;">{!wrapper.pkg.Package__r.Name}</td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold; font-size:8pt; padding:1px 6px 1px 0; white-space:nowrap; vertical-align:top;">Term:</td>
                                    <td style="font-size:8pt; padding:1px 0; vertical-align:top;">{!wrapper.pkg.Package_Term__r.Name}</td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold; font-size:8pt; padding:1px 6px 1px 0; white-space:nowrap; vertical-align:top;">Start Date/Odometer:</td>
                                    <td style="font-size:8pt; padding:1px 0; vertical-align:top;">{!wrapper.contractStartDate}/{!wrapper.pkg.Odometer_Start__c} {!wrapper.pkg.Odometer_Start_Unit__c}</td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold; font-size:8pt; padding:1px 6px 1px 0; white-space:nowrap; vertical-align:top;">Expiry Date/Odometer:</td>
                                    <td style="font-size:8pt; padding:1px 0; vertical-align:top;">{!wrapper.contractEndDate}/{!wrapper.pkg.Odometer_End__c} {!wrapper.pkg.Odometer_End_Unit__c}</td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold; font-size:8pt; padding:1px 6px 1px 0; white-space:nowrap; vertical-align:top;">Additional Options:</td>
                                    <td style="font-size:8pt; padding:1px 0; vertical-align:top;">
                                        <apex:repeat value="{!wrapper.includedOptions}" var="option">
                                            <apex:outputText value="{!option.Option__c}, " />
                                        </apex:repeat>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" style="text-align:right; padding:3px 8px 5px 0; border-top:1px solid #eee;">
                            <span style="font-size:6pt;">Warranty Cost: $<apex:outputText value="{0,number,###,##0.00}"><apex:param value="{!wrapper.pkg.Contract_Premium_Price_Without_Tax__c}" /></apex:outputText></span>
                            <span style="font-size:6pt; margin-left:8px;">Tax ({!wrapper.pkg.Tax_Percentage__c}%): $<apex:outputText value="{0,number,###,##0.00}"><apex:param value="{!wrapper.pkg.Tax_Amount__c}" /></apex:outputText></span>
                            <span style="font-size:6pt; margin-left:8px;">Total: $<apex:outputText value="{0,number,###,##0.00}"><apex:param value="{!wrapper.pkg.Contract_Premium_Price__c}" /></apex:outputText></span>
                        </td>
                    </tr>
                </table>

                <!-- ===== SECTION 4: CUSTOMER ACKNOWLEDGEMENT ===== -->
                <div class="section-header">SECTION 4: CUSTOMER ACKNOWLEDGEMENT</div>
                <div style="border:1px solid #ccc; border-top:none; padding:8px 10px;">
                    <!-- Legal text -->
                    <div style="font-size:8pt; line-height:1.4; text-align:justify; color:#222;">
                        I acknowledge that I have received, read, reviewed, and understood this A-Protect Vehicle Service Agreement (&quot;Agreement&quot;), including all terms, conditions, coverage provisions, exclusions, limitations, cancellation provisions, transfer provisions, claim procedures, and any applicable aggregate claim limits. I certify that all information provided on this Application and Registration Page is true, complete, and accurate to the best of my knowledge and understand that this Agreement has been issued based upon the information provided during the application and registration process. I understand that prior authorization from A-Protect Warranty Corporation is required before any covered repairs are commenced and that failure to obtain such authorization may result in denial of coverage. I further understand that any mechanical failure, loss, or damage resulting from a pre-existing condition is not covered under this Agreement. I acknowledge that this Application and Registration Page, together with the Terms and Conditions of this Agreement, constitute the entire agreement between myself and A-Protect Warranty Corporation and that no oral statements, promises, representations, or assurances made by any dealer, salesperson, agent, or representative shall modify, expand, or alter the coverage provided under this Agreement. I understand that the purchase of this Agreement is optional and is not required as a condition of purchasing, leasing, financing, or obtaining credit for the covered vehicle, and that neither the extension of credit, the terms of credit, nor the terms of the vehicle sale or lease are conditioned upon the purchase of this Agreement. I further acknowledge that this Agreement is a Vehicle Service Agreement and not an insurance contract, automobile liability insurance policy, or physical damage insurance policy, and that all benefits, authorizations, approvals, reimbursements, and payments are administered solely in accordance with the terms, conditions, limitations, and exclusions contained herein.
                    </div>

                    <div style="height:10px;"></div>

                    <!-- Signature instruction -->
                    <div style="font-size:8pt; font-weight:bold; margin-bottom:6px;">By signing below, or by providing electronic consent, the Customer acknowledges acceptance of and agreement to all terms, conditions, limitations, and provisions contained within this Agreement.</div>

                    <!-- Signature + Date boxes -->
                    <table style="width:55%; border-collapse:collapse; margin-top:12px;">
                        <tr>
                            <td style="width:60%; border-bottom:1px solid #000; height:35px; vertical-align:bottom; padding-bottom:2px;"></td>
                            <td style="width:10%;"></td>
                            <td style="width:30%; border-bottom:1px solid #000; height:35px; vertical-align:bottom; padding-bottom:2px;"></td>
                        </tr>
                        <tr>
                            <td style="font-size:8pt; color:#333; padding-top:2px;">Customer Signature</td>
                            <td></td>
                            <td style="font-size:8pt; color:#333; padding-top:2px;">Date</td>
                        </tr>
                    </table>
                </div>

                <!-- ======================== TERMS AND CONDITIONS PAGES ======================== -->
                <apex:outputPanel rendered="{!wrapper.hasTermsAndConditions}">
                    <div style="page-break-before:always;"></div>

                    <!-- TC HEADER -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:4px;">
                        <tr>
                            <td style="width:60%; vertical-align:middle;">
                                <apex:outputPanel rendered="{!hasDealerLogo}" layout="none">
                                    <div style="display:inline-block; vertical-align:middle; margin-right:8px;">
                                        <img src="{!dealerLogoUrl}" width="80" height="35" />
                                    </div>
                                </apex:outputPanel>
                                <div style="display:inline-block; vertical-align:middle;">
                                    <div style="font-size:11pt; font-weight:bold; color:#1a1a2e;">
                                        <apex:outputPanel rendered="{!wrapper.isTireRim}">Tire &amp; Rim Protection Plan</apex:outputPanel>
                                        <apex:outputPanel rendered="{!NOT(wrapper.isTireRim)}">A-Protect Extended Limited Warranty</apex:outputPanel>
                                    </div>
                                    <div style="font-size:8pt; font-weight:bold; color:#1a1a2e;">Vehicle Service Contract</div>
                                </div>
                            </td>
                            <td style="width:40%; text-align:right; vertical-align:top;">
                                <apex:outputPanel rendered="{!AND(dealerName != '', dealerName != null)}">
                                    <div style="font-size:7.5pt; color:#444; line-height:1.4;">
                                        <span style="font-weight:bold;">{!dealerName}</span><br/>
                                        <apex:outputPanel rendered="{!AND(dealerAddress != '', dealerAddress != null)}">{!dealerAddress}<br/></apex:outputPanel>
                                        <apex:outputPanel rendered="{!AND(dealerPhone != '', dealerPhone != null)}">Tel: {!dealerPhone}<br/></apex:outputPanel>
                                        <apex:outputPanel rendered="{!AND(dealerWebsite != '', dealerWebsite != null)}">{!dealerWebsite}</apex:outputPanel>
                                        <apex:outputPanel rendered="{!AND(dealerEmail != '', dealerEmail != null)}"> | {!dealerEmail}</apex:outputPanel>
                                    </div>
                                </apex:outputPanel>
                            </td>
                        </tr>
                    </table>
                    <div style="height:3px; background:#cc0000;"></div>

                    <!-- IMPORTANT NOTICE -->
                    <div style="font-size:8pt; font-weight:bold; margin:8px 0; text-align:justify; line-height:1.4; padding:6px 8px; background:#f5f5f5; border:1px solid #ddd;">
                        IMPORTANT NOTICE: THIS IS NOT AN INSURANCE POLICY. This is a Vehicle Service Contract.
                        Please read this agreement carefully and keep it in a safe place with your other important documents.
                    </div>

                    <!-- TC TITLE -->
                    <div style="text-align:center; font-size:13pt; font-weight:bold; margin:8px 0 10px 0; letter-spacing:1px;">TERMS AND CONDITIONS</div>

                    <!-- DYNAMIC TC CONTENT -->
                    <div class="tc-body">
                        <apex:outputText value="{!wrapper.termsAndConditions}" escape="false" />
                    </div>

                    <!-- SIGNATURE TABLE AT END -->
                    <table style="width:100%; border-collapse:collapse; margin-top:16px;">
                        <tr>
                            <td style="width:35%; background:#d0d0d0; padding:5px 6px; font-weight:bold; font-size:8pt; border:1px solid #999;">CUSTOMER SIGNATURE</td>
                            <td style="width:15%; border:1px solid #999;"></td>
                            <td style="width:20%; background:#d0d0d0; padding:5px 6px; font-weight:bold; font-size:8pt; border:1px solid #999;">DATE</td>
                            <td style="width:30%; border:1px solid #999;"></td>
                        </tr>
                        <tr>
                            <td style="width:35%; background:#d0d0d0; padding:5px 6px; font-weight:bold; font-size:8pt; border:1px solid #999;">CUSTOMER SIGNATURE</td>
                            <td style="width:15%; border:1px solid #999;"></td>
                            <td style="width:20%; background:#d0d0d0; padding:5px 6px; font-weight:bold; font-size:8pt; border:1px solid #999;">DATE</td>
                            <td style="width:30%; border:1px solid #999;"></td>
                        </tr>
                    </table>
                </apex:outputPanel>

                <!-- PAGE BREAK BETWEEN PACKAGES -->
                <div class="page-break"></div>

            </apex:repeat>
        </apex:repeat>
    </div>
</apex:page>