<apex:page controller="ZZ_SigProbe_Controller2" renderAs="pdf" applyHtmlTag="false" applyBodyTag="false" showHeader="false" standardStylesheets="false" cache="false" language="en-US">
<html>
<head>
<style type="text/css">
  @page { size: letter; margin: 0.45in 0.5in 0.5in 0.5in; }
  body { font-family: Arial, Helvetica, sans-serif; font-size: 8pt; color:#111111; margin:0; padding:0; }
  .lab { font-size: 7pt; color:#b3121f; font-weight:bold; margin: 0 0 3px 0; }
  .sub { font-size: 6.5pt; color:#3f4a5c; margin: 3px 0 0 0; }
  .blk { border: 0.5pt solid #c9cfda; padding: 6px 8px; margin: 0 0 7px 0; }
  .sig { width: 2.5in; }
</style>
</head>
<body>

<div class="blk">
  <div class="lab">P2-A STATIC RESOURCE white PNG 2.5in - control</div>
  <img class="sig" src="{!$Resource.ZZ_SigProbe_SignatureWhite}" />
</div>

<div class="blk">
  <div class="lab">P2-B DATA URI white PNG 2.5in</div>
  <img class="sig" src="{!dataUriWhite}" />
</div>

<div class="blk">
  <div class="lab">P2-C CV FILE relative URL 2.5in</div>
  <img class="sig" src="/sfc/servlet.shepherd/version/download/{!cvId}" />
</div>

<div class="blk">
  <div class="lab">P2-D CV FILE absolute URL 2.5in</div>
  <img class="sig" src="{!instanceUrl}/sfc/servlet.shepherd/version/download/{!cvId}" />
</div>

<div class="blk">
  <div class="lab">P2-E STATIC RESOURCE transparent PNG 2.5in - alpha re-check</div>
  <img class="sig" src="{!$Resource.ZZ_SigProbe_Signature}" />
</div>

<apex:repeat value="{!payloads}" var="p">
<div class="blk">
  <div class="lab">P2-PAYLOAD {!p.label}</div>
  <img class="sig" src="{!p.uri}" />
</div>
</apex:repeat>

</body>
</html>
</apex:page>