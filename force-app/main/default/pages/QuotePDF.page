<apex:page standardController="Application__c" extensions="QuotePDFExtension" applyBodyTag="false" showHeader="false">

    <head>
        <style type="text/css" media="print">
            @page {
                size: letter;
                margin: 0.6in 0.65in 0.9in 0.65in;

                @bottom-center {
                    content: element(footer);
                }
            }

            div.footer {
                display: block;
                padding: 4px 0;
                position: running(footer);
                font-size: 7.5pt;
                text-align: center;
                color: #888888;
                font-family: Arial, Helvetica, sans-serif;
                border-top: 1px solid #cccccc;
                padding-top: 6px;
            }

            .pagenumber:before {
                content: counter(page);
            }

            .pagecount:before {
                content: counter(pages);
            }
        </style>
    </head>

    <style type="text/css">
        body, table, td, th, div, span, p {
            font-family: Arial, Helvetica, sans-serif;
            color: #2d2d2d;
        }
        body {
            margin: 0;
            padding: 0;
            font-size: 9pt;
        }

        .page-break { page-break-after: always; }

        /* Section headers */
        .section-header {
            background-color: #1B2A4A;
            color: #ffffff;
            padding: 7px 14px;
            font-weight: bold;
            font-size: 9.5pt;
            margin-top: 14px;
            margin-bottom: 0;
            letter-spacing: 1px;
        }

        /* Field labels and values */
        .field-label {
            font-weight: bold;
            font-size: 8.5pt;
            color: #555555;
            padding: 3px 10px 3px 0;
            white-space: nowrap;
            vertical-align: top;
        }
        .field-value {
            font-size: 8.5pt;
            color: #1a1a1a;
            padding: 3px 0;
            vertical-align: top;
        }

        /* Package boxes */
        .pkg-box {
            border: 1px solid #d0d0d0;
            margin-top: 8px;
            margin-bottom: 8px;
        }
        .pkg-box-header {
            background-color: #E8EEF4;
            padding: 7px 14px;
            font-weight: bold;
            font-size: 9.5pt;
            color: #1B2A4A;
            border-bottom: 1px solid #d0d0d0;
        }
        .pkg-box-body {
            padding: 10px 14px;
            font-size: 8.5pt;
        }

        /* Service pill table */
        .svc-pill {
            background-color: #3B6CB4;
            color: #ffffff;
            padding: 4px 12px;
            font-size: 7.5pt;
            font-weight: bold;
            letter-spacing: 0.3px;
            white-space: nowrap;
        }

        /* Pricing rows */
        .price-row td {
            padding: 4px 0;
            font-size: 8.5pt;
        }
        .price-total td {
            padding: 6px 0 2px 0;
            font-size: 9pt;
            font-weight: bold;
            border-top: 1.5px solid #1B2A4A;
        }

        /* TC styling */
        .tc-body {
            font-size: 8.5pt;
            line-height: 1.5;
            text-align: justify;
            color: #333333;
        }
        .tc-body p { margin: 4px 0; }
        .tc-body h1, .tc-body h2, .tc-body h3 {
            font-size: 9.5pt;
            margin: 10px 0 4px 0;
            font-weight: bold;
            color: #1B2A4A;
        }
        .tc-body ol, .tc-body ul { margin: 4px 0; padding-left: 18px; }
        .tc-body li { margin: 2px 0; }
    </style>

    <!-- WATERMARK - very light to not obstruct content -->
    <div style="position: fixed; top: 280px; left: 80px; font-size: 100pt; font-weight: bold; color: #F3F3F3; font-family: Arial, Helvetica, sans-serif; letter-spacing: 20px;">QUOTE</div>

    <!-- FOOTER -->
    <div class="footer">
        <apex:outputPanel rendered="{!AND(NOT(useAprotectBranding), dealerName != null, dealerName != '')}">
            <span style="color:#666666;">{!dealerName}
                <apex:outputPanel rendered="{!AND(dealerPhone != '', dealerPhone != null)}"> | Tel: {!dealerPhone}</apex:outputPanel>
                <apex:outputPanel rendered="{!AND(dealerWebsite != '', dealerWebsite != null)}"> | {!dealerWebsite}</apex:outputPanel>
            </span>
            <span style="margin:0 8px;">|</span>
        </apex:outputPanel>
        Page <span class="pagenumber"/> of <span class="pagecount"/>
    </div>

    <div>

        <!-- ===== HEADER ===== -->
        <table style="width:100%; border-collapse:collapse;">
            <tr>
                <!-- Logo + Dealer Info -->
                <td style="width:55%; padding:0 0 8px 0; vertical-align:top;">
                    <apex:outputPanel rendered="{!AND(hasDealerLogo, showLogoOnPdf)}">
                        <apex:image url="{!dealerLogoUrl}" width="160" />
                        <div style="font-size:7.5pt; color:#666666; margin-top:6px; line-height:1.5;">
                            <apex:outputPanel rendered="{!AND(dealerName != null, dealerName != '')}">
                                <div style="font-weight:bold; font-size:8.5pt; color:#1B2A4A;">{!dealerName}</div>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!AND(dealerAddress != null, dealerAddress != '')}">
                                <div>{!dealerAddress}</div>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!AND(dealerPhone != null, dealerPhone != '')}">
                                <div>Tel: {!dealerPhone}</div>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!AND(dealerEmail != null, dealerEmail != '')}">
                                <div>{!dealerEmail}</div>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!AND(dealerWebsite != null, dealerWebsite != '')}">
                                <div>{!dealerWebsite}</div>
                            </apex:outputPanel>
                        </div>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!useAprotectBranding}">
                        <apex:image url="{!URLFOR($Resource.AProtectLogo)}" width="160" />
                    </apex:outputPanel>
                </td>

                <!-- Quote Number Block -->
                <td style="width:45%; text-align:right; vertical-align:top; padding:0;">
                    <table style="border-collapse:collapse; margin-left:auto;">
                        <tr>
                            <td style="background-color:#1B2A4A; padding:10px 20px; text-align:center;">
                                <div style="font-size:8pt; font-weight:bold; color:#8EAAD0; letter-spacing:1.5px;">QUOTE NUMBER</div>
                                <div style="font-weight:bold; color:#ffffff; font-size:22pt; margin-top:2px; letter-spacing:1px;">{!Application__c.Name}</div>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align:center; padding:6px 0 0 0;">
                                <div style="font-size:7.5pt; color:#999999; font-style:italic;">QUOTE - NOT A BINDING CONTRACT</div>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <!-- Accent bar -->
        <div style="height:3px; background-color:#3B6CB4; margin-bottom:0;"></div>

        <!-- ===== VEHICLE INFORMATION ===== -->
        <div class="section-header">VEHICLE INFORMATION</div>
        <table style="width:100%; border-collapse:collapse; background-color:#F8F9FB;">
            <tr>
                <td style="width:50%; padding:10px 14px; vertical-align:top; border-right:1px solid #e0e0e0;">
                    <table style="border-collapse:collapse; width:100%;">
                        <tr><td class="field-label">YEAR</td><td class="field-value">{!Application__c.Vehicle_Year__c}</td></tr>
                        <tr><td class="field-label">MAKE</td><td class="field-value">{!Application__c.Vehicle_Make__c}</td></tr>
                        <tr><td class="field-label">MODEL</td><td class="field-value">{!Application__c.Vehicle_Model__c}</td></tr>
                    </table>
                </td>
                <td style="width:50%; padding:10px 14px; vertical-align:top;">
                    <table style="border-collapse:collapse; width:100%;">
                        <tr><td class="field-label">VIN</td><td class="field-value">{!Application__c.Vehicle_VIN__c}</td></tr>
                        <tr><td class="field-label">ODOMETER</td><td class="field-value">{!Application__c.Odometer__c}</td></tr>
                        <tr><td class="field-label">PURCHASE PRICE</td><td class="field-value">${!Application__c.Vehicle_Purchase_Price__c}</td></tr>
                    </table>
                </td>
            </tr>
        </table>

        <!-- ===== COVERAGE DETAILS ===== -->
        <div class="section-header">COVERAGE DETAILS</div>

        <apex:repeat value="{!packageWrappersList}" var="wrapper">
            <div class="pkg-box">
                <div class="pkg-box-header">
                    {!wrapper.pkg.Package__r.Name}
                </div>
                <div class="pkg-box-body">
                    <table style="width:100%; border-collapse:collapse;">
                        <tr>
                            <!-- Left: Coverage details + services -->
                            <td style="width:55%; vertical-align:top; padding-right:14px;">
                                <table style="border-collapse:collapse;">
                                    <tr><td class="field-label">COVERAGE TERM</td><td class="field-value">{!wrapper.pkg.Package_Term__r.Name}</td></tr>
                                </table>

                                <!-- Included Services as 3-column grid -->
                                <apex:outputPanel rendered="{!wrapper.includedOptions.size > 0}">
                                    <div style="margin-top:8px;">
                                        <div style="font-weight:bold; font-size:7.5pt; color:#3B6CB4; letter-spacing:0.5px; margin-bottom:4px;">INCLUDED SERVICES</div>
                                        <table style="border-collapse:separate; border-spacing:3px;">
                                            <apex:repeat value="{!wrapper.includedOptions}" var="option">
                                                <tr><td class="svc-pill">{!option.Option__c}</td></tr>
                                            </apex:repeat>
                                        </table>
                                    </div>
                                </apex:outputPanel>
                            </td>

                            <!-- Right: Pricing -->
                            <td style="width:45%; vertical-align:top; border-left:1px solid #e0e0e0; padding-left:14px;">
                                <div style="font-weight:bold; font-size:7.5pt; color:#3B6CB4; letter-spacing:0.5px; margin-bottom:6px;">PRICING</div>
                                <table style="width:100%; border-collapse:collapse;">
                                    <tr class="price-row">
                                        <td>Retail Price</td>
                                        <td style="text-align:right;">${!wrapper.retailPriceTotal}</td>
                                    </tr>
                                    <tr class="price-row">
                                        <td>Tax ({!wrapper.pkg.Tax_Percentage__c}%)</td>
                                        <td style="text-align:right;">${!wrapper.pkg.Tax_Amount__c}</td>
                                    </tr>
                                    <tr class="price-total">
                                        <td>Package Total</td>
                                        <td style="text-align:right;">${!wrapper.pkg.Contract_Premium_Price__c}</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </apex:repeat>

        <!-- ===== QUOTE TOTAL ===== -->
        <table style="width:100%; border-collapse:collapse; margin-top:12px;">
            <tr>
                <td style="width:55%; vertical-align:middle; padding-right:14px;">
                    <div style="font-size:7.5pt; color:#888888; font-style:italic; line-height:1.4;">
                        This is a quote only and does not constitute a binding agreement.
                        Pricing is subject to change. Please contact your dealer to finalize coverage.
                    </div>
                </td>
                <td style="width:45%;">
                    <table style="width:100%; border-collapse:collapse;">
                        <tr>
                            <td style="background-color:#1B2A4A; padding:10px 14px; font-weight:bold; font-size:11pt; color:#ffffff; letter-spacing:0.5px;">QUOTE TOTAL</td>
                            <td style="background-color:#1B2A4A; padding:10px 14px; text-align:right; font-weight:bold; font-size:14pt; color:#ffffff;">${!quoteTotal}</td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <!-- Spacer before TC pages -->
        <div style="height:20px;"></div>

    </div>
</apex:page>