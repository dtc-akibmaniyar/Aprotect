<apex:page standardController="Application__c" 
    extensions="QuotePDFExtension" 
    applyBodyTag="false" 
    applyHtmlTag="false"
    showHeader="false"
    renderAs="pdf">

<html>
<head>
    <style type="text/css">

        @page {
            size: letter;
            margin: 0.5in 0.5in 0.5in 0.5in;
        }

        body, table, td, th, div, span, p {
            font-family: Arial, Helvetica, sans-serif;
            color: #2d2d2d;
        }
        body {
            margin: 0;
            padding: 0;
            font-size: 9pt;
        }

        .quote-header {
            font-size: 24pt;
            font-weight: bold;
            color: rgb(55,117,184);
            font-family: Arial, Helvetica, sans-serif;
        }

        .section-header-td {
            background-color: #1B2A4A;
            color: #ffffff;
            padding: 6px 12px;
            font-weight: bold;
            font-size: 8.5pt;
        }

        .info-panel-td {
            background-color: #F8F9FB;
            border: 1px solid #E0E0E0;
            padding: 8px 12px;
        }

        .field-label {
            font-weight: bold;
            font-size: 7.5pt;
            color: #666666;
            padding: 2px 8px 2px 0;
            vertical-align: top;
        }
        .field-value {
            font-size: 8pt;
            color: #1a1a1a;
            padding: 2px 0;
            vertical-align: top;
        }

        .plan-header-td {
            background-color: #F0F4F8;
            padding: 5px 10px;
            font-weight: bold;
            font-size: 8pt;
            color: #1B2A4A;
            border-bottom: 1px solid #D0D0D0;
        }
        .plan-body-td {
            padding: 6px 10px;
            font-size: 7.5pt;
        }
        .plan-label {
            font-weight: bold;
            font-size: 7pt;
            color: #888888;
        }
        .plan-value {
            font-size: 7.5pt;
            color: #333333;
        }

        .plan-price-td {
            text-align: right;
            font-size: 10pt;
            font-weight: bold;
            color: #1B2A4A;
            padding: 4px 10px;
            border-top: 1px solid #D0D0D0;
            background-color: #FAFAFA;
        }

        .totals-label {
            text-align: left;
            color: #555555;
            padding: 3px 10px;
            font-size: 8pt;
        }
        .totals-value {
            text-align: right;
            font-weight: bold;
            color: #1a1a1a;
            padding: 3px 10px;
            font-size: 8pt;
        }

        .grand-total-td {
            background-color: #1B2A4A;
            color: #ffffff;
            padding: 8px 10px;
            font-weight: bold;
            font-size: 10pt;
        }

        
        /* ===== FIXED FOOTER ===== */
        .page-footer {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
        }

        .disclaimer-box {
            border: 2px solid #333333;
            margin-bottom: 6px;
        }
        .disclaimer-header {
            background-color: #C8A84E;
            text-align: center;
            padding: 3px 8px;
            font-weight: bold;
            font-size: 7pt;
            color: #000000;
        }
        .disclaimer-body {
            background-color: #FFFBE6;
            padding: 5px 10px;
            font-size: 6pt;
            color: #333333;
            line-height: 1.3em;
        }

        .footer-tagline {
            text-align: center;
            font-size: 8pt;
            padding: 3px 0;
            color: #333333;
            letter-spacing: 1px;
        }
        .footer-tagline-highlight {
            font-weight: bold;
            color: #C8A84E;
        }

        .footer-contact-table {
            width: 100%;
            border-collapse: collapse;
        }
        .footer-contact-table td {
            font-size: 6pt;
            color: #555555;
            padding: 2px 10px;
            vertical-align: top;
            line-height: 1.4em;
        }
        .footer-col-divider {
            border-left: 1px solid #C8A84E;
            padding-left: 12px;
        }
        .footer-contact-name {
            font-weight: bold;
            color: #1B2A4A;
            font-size: 6.5pt;
        }


        /* Dealer logo - upper right corner */
        .dealer-logo-wrapper {
            position: fixed;
            top: 0;
            right: 0;
            z-index: 1;
            text-align: right;
            padding: 5px;
            margin-bottom: 50px;
        }
        .dealer-logo-wrapper img {
            width: 120px;
            height: auto;
        }

        /* Watermark - centered behind all content */
        .watermark-wrapper {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            text-align: center;
            padding-top: 250px;
        }
        .watermark-wrapper img {
            opacity: 0.06;
        }

    </style>
</head>
<body>

    <!-- ===== WATERMARK - centered background ===== -->
    <div class="watermark-wrapper">
        <apex:image value="{!URLFOR($Resource.QuoteWatermark)}" width="500" />
    </div>


    <!-- ===== DEALER LOGO - upper right corner ===== -->
    <apex:outputPanel layout="none" rendered="{!hasDealerLogo}">
        <div class="dealer-logo-wrapper">
            <apex:image value="{!dealerLogoUrl}" width="120" />
        </div>
    </apex:outputPanel>

    <!-- ===== QUOTE HEADER ===== -->
    <table style="width:100%; border-collapse:collapse; margin-bottom:10px; margin-top:20px;">
        <tr>
            <td style="text-align:left; vertical-align:bottom;">
                <span class="quote-header">QUOTE</span>
            </td>
            <td style="text-align:right; vertical-align:bottom; font-size:7.5pt; color:#888888; font-weight:bold;">
                DATE&#160;&#160;
                <apex:outputText value="{0, date, dd-MM-yyyy}">
                    <apex:param value="{!NOW()}"/>
                </apex:outputText>
            </td>
        </tr>
    </table>

    <!-- ===== MAIN TWO-COLUMN LAYOUT ===== -->
    <table style="width:100%; border-collapse:collapse;">
        <tr>

            <!-- ===== LEFT COLUMN ===== -->
            <td style="width:48%; vertical-align:top; padding-right:10px;">

                <!-- Customer Information -->
                <table style="width:100%; border-collapse:collapse; margin-bottom:10px;">
                    <tr>
                        <td class="section-header-td">CUSTOMER INFORMATION</td>
                    </tr>
                    <tr>
                        <td class="info-panel-td">
                            <table style="width:100%; border-collapse:collapse;">
                                <tr>
                                    <td style="font-weight:bold; font-size:9pt; color:#1B2A4A; padding-bottom:4px;">
                                        {!Application__c.Customer_First_Name__c}&#160;{!Application__c.Customer_Last_Name__c}
                                    </td>
                                </tr>
                                <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(Application__c.Customer_Name__r.BillingStreet))}">
                                    <tr>
                                        <td class="field-value">{!Application__c.Customer_Name__r.BillingStreet}</td>
                                    </tr>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!OR(NOT(ISBLANK(Application__c.Customer_Name__r.BillingCity)), NOT(ISBLANK(Application__c.Customer_Name__r.BillingState)), NOT(ISBLANK(Application__c.Customer_Name__r.BillingPostalCode)))}">
                                    <tr>
                                        <td class="field-value">
                                            {!Application__c.Customer_Name__r.BillingCity}
                                            <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(Application__c.Customer_Name__r.BillingState))}">&#160;{!Application__c.Customer_Name__r.BillingState}</apex:outputPanel>
                                            <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(Application__c.Customer_Name__r.BillingPostalCode))}">&#160;{!Application__c.Customer_Name__r.BillingPostalCode}</apex:outputPanel>
                                        </td>
                                    </tr>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(Application__c.Customer_Name__r.Phone))}">
                                    <tr>
                                        <td class="field-value">Tel: {!Application__c.Customer_Name__r.Phone}</td>
                                    </tr>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(Application__c.Customer_Name__r.PersonEmail))}">
                                    <tr>
                                        <td class="field-value">E-mail: {!Application__c.Customer_Name__r.PersonEmail}</td>
                                    </tr>
                                </apex:outputPanel>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- Vehicle Information -->
                <table style="width:100%; border-collapse:collapse;">
                    <tr>
                        <td class="section-header-td">VEHICLE INFORMATION</td>
                    </tr>
                    <tr>
                        <td class="info-panel-td">
                            <table style="width:100%; border-collapse:collapse;">
                                <tr>
                                    <td colspan="2" style="font-weight:bold; font-size:9pt; color:#1B2A4A; padding-bottom:6px;">
                                        {!Application__c.Vehicle_Year__c}&#160;{!Application__c.Vehicle_Make__c}&#160;{!Application__c.Vehicle_Model__c}&#160;{!Application__c.Vehicle__r.Trim__c}
                                    </td>
                                </tr>
                                <tr>
                                    <td class="field-label">VIN#:</td>
                                    <td class="field-value">{!Application__c.Vehicle_VIN__c}</td>
                                </tr>
                                <tr>
                                    <td class="field-label">Odometer:</td>
                                    <td class="field-value">
                                        <apex:outputText value="{0, number, ###,###}">
                                            <apex:param value="{!Application__c.Odometer__c}"/>
                                        </apex:outputText>&#160;{!Application__c.Vehicle__r.Odometer_Unit__c}
                                    </td>
                                </tr>
                                <tr>
                                    <td class="field-label">Purchase Price:</td>
                                    <td class="field-value">
                                        <apex:outputText value="${0, number, ###,##0.00}">
                                            <apex:param value="{!Application__c.Vehicle_Purchase_Price__c}"/>
                                        </apex:outputText>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="field-label">Delivery Date:</td>
                                    <td class="field-value">
                                        <apex:outputText value="{0, date, MM-dd-yyyy}">
                                            <apex:param value="{!Application__c.Vehicle__r.Delivery_Date__c}"/>
                                        </apex:outputText>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="field-label">Transmission:</td>
                                    <td class="field-value">{!Application__c.Vehicle__r.Transmission__c}</td>
                                </tr>
                                <tr>
                                    <td class="field-label">Fuel:</td>
                                    <td class="field-value">{!Application__c.Vehicle__r.Fuel_Type__c}</td>
                                </tr>
                                <tr>
                                    <td class="field-label">Engine Size:</td>
                                    <td class="field-value">{!Application__c.Vehicle__r.Engine__c}</td>
                                </tr>
                                <tr>
                                    <td class="field-label">Colour:</td>
                                    <td class="field-value">{!Application__c.Vehicle__r.Color__c}</td>
                                </tr>
                                <tr>
                                    <td class="field-label">Body Type:</td>
                                    <td class="field-value">{!Application__c.Vehicle__r.Body_Style__c}</td>
                                </tr>
                                <tr>
                                    <td class="field-label">Business/Commercial Use:</td>
                                    <td class="field-value">
                                        <apex:outputText value="{!IF(Application__c.Vehicle__r.Business_Commercial_Use__c, 'Yes', 'No')}"/>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

            </td><!-- end left column -->

            <!-- ===== RIGHT COLUMN ===== -->
            <td style="width:52%; vertical-align:top; padding-left:10px;">

                <table style="width:100%; border-collapse:collapse;">
                    <tr>
                        <td class="section-header-td">SERVICE PLAN</td>
                    </tr>
                    <tr>
                        <td style="border:1px solid #E0E0E0; border-top:none; padding:0;">

                            <!-- Package list -->
                            <apex:repeat value="{!packageWrappersList}" var="wrapper">
                                <table style="width:100%; border-collapse:collapse; border-bottom:1px solid #D0D0D0;">
                                    <tr>
                                        <td class="plan-header-td">
                                            {!wrapper.pkg.Package__r.Name}
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="plan-body-td">
                                            <table style="width:100%; border-collapse:collapse;">
                                                <tr>
                                                    <td class="plan-label">Term:</td>
                                                </tr>
                                                <tr>
                                                    <td class="plan-value">
                                                        <apex:outputText value="{!IF(ISBLANK(wrapper.pkg.Package_Term__r.Name), 'N/A', wrapper.pkg.Package_Term__r.Name)}"/>
                                                    </td>
                                                </tr>
                                                <apex:outputPanel layout="none" rendered="{!wrapper.optionalOptions.size > 0}">
                                                    <tr>
                                                        <td class="plan-label" style="padding-top:3px;">Additional Options:</td>
                                                    </tr>
                                                    <tr>
                                                        <td class="plan-value">
                                                            <apex:repeat value="{!wrapper.optionalOptions}" var="opt">
                                                                {!opt.Option__c}
                                                                <apex:outputPanel layout="none" rendered="{!opt.Retail_Price__c != null && opt.Retail_Price__c > 0}">
                                                                    (<apex:outputText value="${0, number, ###,##0.00}"><apex:param value="{!opt.Retail_Price__c}"/></apex:outputText>)
                                                                </apex:outputPanel>
                                                                <apex:outputText value=", " rendered="{!opt != wrapper.optionalOptions[wrapper.optionalOptions.size - 1]}"/>
                                                            </apex:repeat>
                                                        </td>
                                                    </tr>
                                                </apex:outputPanel>
                                            </table>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="plan-price-td">
                                            <table style="width:100%; border-collapse:collapse;">
                                                <tr>
                                                    <td style="text-align:left; font-size:7.5pt; font-weight:normal; color:#666666;">PRICE</td>
                                                    <td style="text-align:right;">
                                                        <apex:outputText value="${0, number, ###,##0.00}">
                                                            <apex:param value="{!wrapper.retailPriceTotal}"/>
                                                        </apex:outputText>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </apex:repeat>

                            <!-- Totals -->
                            <table style="width:100%; border-collapse:collapse; border-top:2px solid #1B2A4A;">
                                <tr>
                                    <td class="totals-label">Sub-Total</td>
                                    <td class="totals-value">
                                        <apex:outputText value="${0, number, ###,##0.00}">
                                            <apex:param value="{!quoteTotal}"/>
                                        </apex:outputText>
                                    </td>
                                </tr>
                                <apex:outputPanel layout="none" rendered="{!taxTotal != null && taxTotal > 0}">
                                <tr>
                                    <td class="totals-label">Tax</td>
                                    <td class="totals-value">
                                        <apex:outputText value="${0, number, ###,##0.00}">
                                            <apex:param value="{!taxTotal}"/>
                                        </apex:outputText>
                                    </td>
                                </tr>
                            </apex:outputPanel>
                            </table>

                            <!-- Grand Total -->
                            <table style="width:100%; border-collapse:collapse;">
                                <tr>
                                    <td class="grand-total-td" style="text-align:left;">Total:</td>
                                    <td class="grand-total-td" style="text-align:right;">
                                        <apex:outputText value="${0, number, ###,##0.00}">
                                            <apex:param value="{!grandTotal}"/>
                                        </apex:outputText>
                                    </td>
                                </tr>
                            </table>

                        </td>
                    </tr>
                </table>

            </td><!-- end right column -->
        </tr>
    </table>

    <!-- ===== FIXED FOOTER ===== -->
    <div class="page-footer">
        <div class="disclaimer-box">
            <div class="disclaimer-header">IMPORTANT:</div>
            <div class="disclaimer-body">
                This quotation is an estimate only and does not constitute a final offer. Pricing, costs,
                and package eligibility are based on the vehicle information provided at the time of quoting
                and may change if any vehicle details are updated. The packages shown may no longer apply,
                or different packages may become available, following any changes to the vehicle information.
            </div>
        </div>

        <div class="footer-tagline">
            THE BEST CHOICE IN <span class="footer-tagline-highlight">AUTO WARRANTY</span>
        </div>

        <table class="footer-contact-table">
            <tr>
                <td style="width:34%;">
                    <span class="footer-contact-name">A-Protect Warranty Corporation</span><br/>
                    8800 Dufferin St. Suite 302B<br/>
                    Concord, ON L4K 1Z8
                </td>
                <td class="footer-col-divider" style="width:33%;">
                    Toll Free: 1-866-660-6444<br/>
                    Local: +1 416-661-7444<br/>
                    Fax: +1 905-761-4344
                </td>
                <td class="footer-col-divider" style="width:33%;">
                    info@a-protectwarranty.com<br/>
                    www.a-protectwarranty.com
                </td>
            </tr>
        </table>
    </div>

</body>
</html>
</apex:page>